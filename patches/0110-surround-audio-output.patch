+/* Surround output. The game's port is 8 channels in the PS3's order -- front
+ * left, front right, centre, LFE, surround left, surround right, rear left,
+ * rear right (RPCS3 issue 11066, from the SDK documentation) -- and was
+ * always folded down to stereo here. The device can now take it as it is:
+ *   s_output_mode     what was asked (cellAudio_set_output_mode): 0 the
+ *                     Windows device's own speaker setup, 2, 6 or 8;
+ *   s_out_channels    what goes to the device: 2 (the fold-down, as before),
+ *                     6 (5.1: FL FR FC LFE BL BR, the rear pair folded into
+ *                     the surround pair) or 8 (7.1 in Windows' order, FL FR
+ *                     FC LFE BL BR SL SR: the PS3's surround pair is
+ *                     Windows' side pair, its rear pair Windows' back pair).
+ * A stereo port stays on the front pair. */
+static int s_output_mode = 0;
+static int s_out_channels = 2;
+static int s_device_channels = 0;
+static int s_game_channels = 0;
+
+void cellAudio_set_output_mode(int channels)
+{
+    s_output_mode = (channels == 2 || channels == 6 || channels == 8) ? channels : 0;
+}
+
+int cellAudio_output_channels(void)
+{
+    return s_audio_initialized ? s_out_channels : 0;
+}
+
+int cellAudio_device_channels(void)
+{
+    return s_device_channels;
+}
+
+void cellAudio_note_game_channels(int channels)
+{
+    s_game_channels = channels;
+}
+
+int cellAudio_game_channels(void)
+{
+    return s_game_channels;
+}
+
+/* The output channel count for a device with `deviceChannels` speakers. */
+static int audio_choose_out_channels(int deviceChannels)
+{
+    if (s_output_mode)
+    {
+        return s_output_mode;
+    }
+    if (deviceChannels >= 8)
+    {
+        return 8;
+    }
+    if (deviceChannels >= 6)
+    {
+        return 6;
+    }
+    return 2;
+}
 
