+    if (request.fd >= 0 && request.fd < FS_MAX && g_files[request.fd])
+    {
+        request.hostPath = g_fd_host_path[request.fd];
+    }
 
-    static int32_t s_next_id = 1;
-    int32_t id = s_next_id++;
-    if (id_ptr) vm_write32(id_ptr, (uint32_t)id);
+    static std::atomic<int32_t> s_nextId(1);
+    request.id = s_nextId++;
+    if (id_ptr) vm_write32(id_ptr, (uint32_t)request.id);
+    ctx->gpr[3] = CELL_OK;
 
-    size_t n = 0;
-    int32_t err = CELL_FS_ENOENT;
-    if (fd >= 0 && fd < FS_MAX && g_files[fd]) {
-        if (ppu_vm_size && (uint64_t)buf + size > ppu_vm_size) size = ppu_vm_size - buf;
-        fs_prefault(buf, size);
-        /* AIO reads are absolute -- they do not disturb the fd's own file
-         * position, and the guest interleaves them freely across threads. */
-        if (HOST_FSEEK64(g_files[fd], offset) == 0)
-            n = fread(vm_base + buf, 1, (size_t)size, g_files[fd]);
-        err = CELL_OK;
+    static int s_sync = -1;
+    if (s_sync < 0) s_sync = getenv("PS3_FS_AIO_SYNC") ? 1 : 0;
+    if (s_sync)
+    {
+        int32_t error = CELL_OK;
+        size_t bytesRead = fs_aio_perform(request, &error);
+        if (getenv("PS3_FSLOG"))
+            fprintf(stderr, "[fs] aio read id=%d fd=%d off=%llu size=%llu -> %zu (sync)\n",
+                    request.id, request.fd, (unsigned long long)request.offset,
+                    (unsigned long long)request.size, bytesRead);
+        if (cb_opd) ps3_invoke_guest(cb_opd, aio, (uint64_t)(int64_t)error,
+                                     (uint64_t)(int64_t)request.id, (uint64_t)bytesRead, 0, 0, 0, 0);
+        return;
     }
-    if (getenv("PS3_FSLOG"))
-        fprintf(stderr, "[fs] aio read id=%d fd=%d off=%llu size=%llu -> %zu\n",
-                id, fd, (unsigned long long)offset, (unsigned long long)size, n);
 
-    ctx->gpr[3] = CELL_OK;
-    if (cb_opd) ps3_invoke_guest(cb_opd, aio, (uint64_t)(int64_t)err,
-                                 (uint64_t)(int64_t)id, (uint64_t)n, 0, 0, 0, 0);
+    std::lock_guard<std::mutex> lock(s_aioMutex);
+    if (!s_aioStarted)
+    {
+        /* 64 KB of guest stack for the callbacks, from the PPU stack region. */
+        uint32_t stackTop = sys_ppu_thread_alloc_host_stack(0x10000u);
+        std::thread(fs_aio_worker, stackTop).detach();
+        s_aioStarted = true;
+    }
+    s_aioQueue.push_back(std::move(request));
+    s_aioWake.notify_one();
 }
 
