 {
     uint32_t aio    = (uint32_t)ctx->gpr[3];
     uint32_t id_ptr = (uint32_t)ctx->gpr[4];
     uint32_t cb_opd = (uint32_t)ctx->gpr[5];
 
-    int      fd     = (int)guest_be32(aio + 0x00);
-    uint64_t offset = guest_be64(aio + 0x08);
-    uint32_t buf    = guest_be32(aio + 0x10);
