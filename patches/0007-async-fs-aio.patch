+/* Completion runs on a worker thread, as lv2's does (RPCS3 shows the title's
+ * own _fs_aio_thread). Completing inside the submit call was wrong for
+ * Folklore: its movie streamer submits a read, THEN marks it outstanding under
+ * a mutex and waits for the callback to clear the mark -- a callback that had
+ * already run before the mark was set, so the logo movie never got its first
+ * 512 KB and the screen stayed black. PS3_FS_AIO_SYNC=1 restores the old
+ * synchronous completion.
+ *
+ * The worker reads through its own host handle, opened from the path, so the
+ * guest's fd position and stdio buffer are untouched (AIO reads are absolute).
+ * It calls the guest back on a guest stack of its own (ppu_guest_call_set_stack). */
+extern "C" void ppu_guest_call_set_stack(uint32_t top);
+extern "C" uint32_t sys_ppu_thread_alloc_host_stack(uint32_t stack_size);
+
+struct FsAioRequest
+{
+    uint32_t aio;
+    uint32_t callbackOpd;
+    int32_t  id;
+    int      fd;
+    uint64_t offset;
+    uint32_t buffer;
+    uint64_t size;
+    std::string hostPath;
+};
+
+static std::mutex                s_aioMutex;
+static std::condition_variable   s_aioWake;
+static std::deque<FsAioRequest>  s_aioQueue;
+static bool                      s_aioStarted = false;
+
+static size_t fs_aio_perform(const FsAioRequest& request, int32_t* error)
+{
+    size_t bytesRead = 0;
+    *error = CELL_FS_ENOENT;
+    FILE* file = request.hostPath.empty() ? nullptr : fopen(request.hostPath.c_str(), "rb");
+    if (!file)
+    {
+        return 0;
+    }
+    uint64_t size = request.size;
+    if (ppu_vm_size && (uint64_t)request.buffer + size > ppu_vm_size)
+    {
+        size = ppu_vm_size - request.buffer;
+    }
+    fs_prefault(request.buffer, size);
+    if (HOST_FSEEK64(file, request.offset) == 0)
+    {
+        bytesRead = fread(vm_base + request.buffer, 1, (size_t)size, file);
+    }
+    fclose(file);
+    *error = CELL_OK;
+    return bytesRead;
+}
+
+static void fs_aio_worker(uint32_t stackTop)
+{
+    ppu_guest_call_set_stack(stackTop);
+    for (;;)
+    {
+        FsAioRequest request;
+        {
+            std::unique_lock<std::mutex> lock(s_aioMutex);
+            s_aioWake.wait(lock, [] { return !s_aioQueue.empty(); });
+            request = std::move(s_aioQueue.front());
+            s_aioQueue.pop_front();
+        }
+        int32_t error = CELL_OK;
+        size_t bytesRead = fs_aio_perform(request, &error);
+        if (getenv("PS3_FSLOG"))
+        {
+            fprintf(stderr, "[fs] aio read id=%d fd=%d off=%llu size=%llu -> %zu (async)\n",
+                    request.id, request.fd, (unsigned long long)request.offset,
+                    (unsigned long long)request.size, bytesRead);
+        }
+        if (request.callbackOpd)
+        {
+            ps3_invoke_guest(request.callbackOpd, request.aio, (uint64_t)(int64_t)error,
+                             (uint64_t)(int64_t)request.id, (uint64_t)bytesRead, 0, 0, 0, 0);
+        }
+    }
+}
+
