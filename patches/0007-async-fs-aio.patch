diff --git a/runtime/syscalls/sys_ppu_thread.c b/runtime/syscalls/sys_ppu_thread.c
index 326dea4..9d801fa 100644
--- a/runtime/syscalls/sys_ppu_thread.c
+++ b/runtime/syscalls/sys_ppu_thread.c
@@ -1279,6 +1279,17 @@ int64_t sys_ppu_thread_get_stack_information(ppu_context* ctx)
 /* ---------------------------------------------------------------------------
  * Registration
  * -----------------------------------------------------------------------*/
+/* A guest stack for a HOST thread that calls into guest code (an HLE worker,
+ * such as the cellFs AIO completion thread). Same region and allocator as the
+ * PPU threads' stacks, under the same lock. Returns the usable top, 0 if none. */
+uint32_t sys_ppu_thread_alloc_host_stack(uint32_t stack_size)
+{
+    table_lock();
+    uint32_t base = vm_stack_allocate(&g_vm_stack_alloc, stack_size);
+    table_unlock();
+    return base ? base + stack_size - 0x100u : 0;
+}
+
 void sys_ppu_thread_init(lv2_syscall_table* tbl)
 {
     /* Initialize stack allocator */
