     snprintf(lbl, sizeof lbl, "%ds sample", t2); dump_threads(lbl, self);
+
+    /* Then keep watching: a game that stops presenting frames after it has
+     * started (Folklore at the underworld portal: sound on, picture and game
+     * frozen, nothing in the log) gets the same dump 5 s and 20 s into the
+     * stall, so the log says which thread is waiting on what. A few reports
+     * per run at most; a long movie can trip it harmlessly. */
+    { LONG lastFrames = g_frames_presented;
+      int stalledSeconds = 0;
+      int reports = 0;
+      while (reports < 6)
+      {
+          Sleep(1000);
+          const LONG frames = g_frames_presented;
+          if (frames != lastFrames || frames == 0)
+          {
+              lastFrames = frames;
+              stalledSeconds = 0;
+              continue;
+          }
+          stalledSeconds++;
+          if (stalledSeconds == 5 || stalledSeconds == 20)
+          {
+              reports++;
+              snprintf(lbl, sizeof lbl, "no frame presented for %d s", stalledSeconds);
+              dump_threads(lbl, self);
+          }
+      } }
