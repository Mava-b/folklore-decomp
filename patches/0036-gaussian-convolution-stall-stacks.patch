+/* Convolution filtering.
+ *
+ * The RSX texture unit can filter through a kernel instead of plain
+ * bilinear: NV4097_SET_TEXTURE_FILTER min 7 (CONVOLUTION_MIN) / mag 4
+ * (CONVOLUTION_MAG), kernel 1 quincunx, 2 Gaussian, 3 quincunx-alternate.
+ * Folklore magnifies its bloom buffer through the Gaussian kernel, and that
+ * is what makes the glow soft. D3D12 has no such sampler state; bilinear
+ * alone shows the low-resolution buffer's texel grid as a pattern of
+ * squares around every light.
+ *
+ * Gaussian: four bilinear taps half a texel out on the diagonals, which is
+ * exactly the 3x3 [1 2 1] x [1 2 1] / 16 kernel over the texel grid, then
+ * interpolated -- a smooth (B-spline-like) reconstruction. Quincunx: the
+ * centre at 1/2 and the four diagonal neighbours one texel out at 1/8 each,
+ * as the hardware resolves its 2x anti-aliased surfaces. Same post-pass
+ * style as rsx_fp_apply_unnorm_scale; the call's own arguments are kept. */
+int rsx_fp_apply_convolution(char* hlsl, u32 hlsl_size, u32 convolution_mask,
+                             const u8 kernels[16], u32 cube_mask)
+{
+    if (!hlsl || !convolution_mask || !kernels)
+    {
+        return 0;
+    }
+    static const char helpers[] =
+        "float4 _rsx_conv_gauss(Texture2D t, SamplerState s, float2 uv) {\n"
+        "    uint w, h; t.GetDimensions(w, h);\n"
+        "    float2 d = 0.5 / float2(max(w, 1u), max(h, 1u));\n"
+        "    return 0.25 * (t.Sample(s, uv + float2(-d.x, -d.y)) + t.Sample(s, uv + float2(d.x, -d.y)) +\n"
+        "                   t.Sample(s, uv + float2(-d.x, d.y)) + t.Sample(s, uv + float2(d.x, d.y)));\n"
+        "}\n"
+        "float4 _rsx_conv_quincunx(Texture2D t, SamplerState s, float2 uv) {\n"
+        "    uint w, h; t.GetDimensions(w, h);\n"
+        "    float2 d = 1.0 / float2(max(w, 1u), max(h, 1u));\n"
+        "    return 0.5 * t.Sample(s, uv) + 0.125 * (t.Sample(s, uv + float2(-d.x, -d.y)) + t.Sample(s, uv + float2(d.x, -d.y)) +\n"
+        "                                         t.Sample(s, uv + float2(-d.x, d.y)) + t.Sample(s, uv + float2(d.x, d.y)));\n"
+        "}\n";
+    int patched = 0;
+    for (u32 unit = 0; unit < 16; unit++)
+    {
+        if (!((convolution_mask >> unit) & 1u) || ((cube_mask >> unit) & 1u))
+        {
+            continue;
+        }
+        const char* helperName = kernels[unit] == 2 ? "_rsx_conv_gauss" : "_rsx_conv_quincunx";
+        /* Both spellings the emitter produces for a 2D unit, and the call
+         * that replaces each. */
+        char needles[2][48];
+        char replacements[2][64];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].Sample(rsx_samp[%u],", unit, unit);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.Sample(rsx_samp[%u],", unit, unit);
+        snprintf(replacements[0], sizeof replacements[0], "%s(rsx_tex[%u], rsx_samp[%u],", helperName, unit, unit);
+        snprintf(replacements[1], sizeof replacements[1], "%s(rsx_tex%u, rsx_samp[%u],", helperName, unit, unit);
+        for (int spelling = 0; spelling < 2; spelling++)
+        {
+            const u32 needleLength = (u32)strlen(needles[spelling]);
+            const u32 replacementLength = (u32)strlen(replacements[spelling]);
+            for (;;)
+            {
+                char* site = strstr(hlsl, needles[spelling]);
+                if (!site)
+                {
+                    break;
+                }
+                const u32 used = (u32)strlen(hlsl);
+                if (used - needleLength + replacementLength + 1 > hlsl_size)
+                {
+                    return -1;
+                }
+                memmove(site + replacementLength, site + needleLength,
+                        used - (u32)(site - hlsl) - needleLength + 1);
+                memcpy(site, replacements[spelling], replacementLength);
+                patched++;
+            }
+        }
+    }
+    if (patched)
+    {
+        const u32 used = (u32)strlen(hlsl);
+        const u32 helperLength = (u32)strlen(helpers);
+        if (used + helperLength + 1 > hlsl_size)
+        {
+            return -1;
+        }
+        memmove(hlsl + helperLength, hlsl, used + 1);
+        memcpy(hlsl, helpers, helperLength);
+    }
+    return patched;
+}
