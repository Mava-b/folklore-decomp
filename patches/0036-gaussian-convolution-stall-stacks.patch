 }
 
+/* Every guest thread's call chain (ppu_dump_guest_stack), for the stall
+ * watchdog: the lr above is one frame, and in a freeze the question is what
+ * each waiting thread was waiting FOR, which is several frames up. */
+extern "C" void ppu_dump_guest_stack(ppu_context*, const char*);
+extern "C" void ppu_report_guest_stacks(void)
+{
+    long count = g_resv_ctx_n;
+    if (count > PPU_RESV_MAX)
+    {
+        count = PPU_RESV_MAX;
+    }
+    for (long index = 0; index < count; index++)
+    {
+        ppu_context* context = g_resv_ctxs[index];
+        if (!context)
+        {
+            continue;
+        }
+        char tag[32];
+        snprintf(tag, sizeof tag, "stall tid %u", (unsigned)context->thread_id);
+        ppu_dump_guest_stack(context, tag);
+    }
+    fflush(stderr);
+}
