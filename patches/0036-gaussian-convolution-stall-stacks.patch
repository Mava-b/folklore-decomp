+/* The RSX texture unit's convolution filters (NV4097_SET_TEXTURE_FILTER min 7
+ * / mag 4, kernel in bits 13-15): rewrite each 2D Sample() on a unit in
+ * `convolution_mask` into a call that applies the kernel -- Gaussian for
+ * kernel 2, quincunx otherwise -- over the texels around the sample point.
+ * Run after rsx_fp_apply_unnorm_scale. Returns the number of call sites
+ * rewritten, or -1 when the buffer is too small. */
+int rsx_fp_apply_convolution(char* hlsl, u32 hlsl_size, u32 convolution_mask,
+                             const u8 kernels[16], u32 cube_mask);
