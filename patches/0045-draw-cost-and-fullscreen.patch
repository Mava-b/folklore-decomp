+        SetWindowPos(s_state.hwnd, HWND_TOP, monitorInfo.rcMonitor.left, monitorInfo.rcMonitor.top,
+                     monitorInfo.rcMonitor.right - monitorInfo.rcMonitor.left,
+                     monitorInfo.rcMonitor.bottom - monitorInfo.rcMonitor.top,
+                     SWP_FRAMECHANGED | SWP_NOOWNERZORDER | SWP_SHOWWINDOW);
+        s_fullscreen_applied = 1;
+        printf("[RSX null] fullscreen on %ldx%ld\n",
+               (long)(monitorInfo.rcMonitor.right - monitorInfo.rcMonitor.left),
+               (long)(monitorInfo.rcMonitor.bottom - monitorInfo.rcMonitor.top));
+    }
+    else
+    {
+        SetWindowLongPtrA(s_state.hwnd, GWL_STYLE, s_windowed_style ? s_windowed_style
+                                                                    : (LONG_PTR)(WS_OVERLAPPEDWINDOW | WS_VISIBLE));
+        SetWindowPlacement(s_state.hwnd, &s_windowed_placement);
+        SetWindowPos(s_state.hwnd, NULL, 0, 0, 0, 0,
+                     SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_FRAMECHANGED);
+        s_fullscreen_applied = 0;
+        printf("[RSX null] fullscreen off\n");
+    }
+}
+
+void rsx_null_backend_set_fullscreen(int enabled)
+{
+    InterlockedExchange(&s_fullscreen_wanted, enabled ? 1 : 0);
+}
+
+void rsx_null_backend_toggle_fullscreen(void)
+{
+    const LONG current = InterlockedCompareExchange(&s_fullscreen_wanted, 0, 0);
+    InterlockedExchange(&s_fullscreen_wanted, current ? 0 : 1);
+}
+
+int rsx_null_backend_is_fullscreen(void)
+{
+    return InterlockedCompareExchange(&s_fullscreen_wanted, 0, 0) != 0;
+}
