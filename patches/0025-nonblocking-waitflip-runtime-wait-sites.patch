+/* The first return address on a sampled thread's stack that lands in this
+ * module but outside lifted code: the runtime function (an HLE, a wait helper)
+ * the thread is in. Returned as an RVA, for the link map. 0 when none. */
+static uint32_t samp_stack_runtime_rva(const CONTEXT* c)
+{
+    static uintptr_t moduleBase = 0, moduleEnd = 0;
+    if (!moduleBase)
+    {
+        const uintptr_t base = (uintptr_t)GetModuleHandleA(NULL);
+        const IMAGE_DOS_HEADER* dos = (const IMAGE_DOS_HEADER*)base;
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + dos->e_lfanew);
+        moduleEnd = base + nt->OptionalHeader.SizeOfImage;
+        moduleBase = base;
+    }
+    const uintptr_t* sp = (const uintptr_t*)c->Rsp;
+    MEMORY_BASIC_INFORMATION region;
+    if (!sp || !VirtualQuery((LPCVOID)sp, &region, sizeof region) ||
+        region.State != MEM_COMMIT ||
+        (region.Protect & (PAGE_NOACCESS | PAGE_GUARD)) ||
+        !(region.Protect & (PAGE_READONLY | PAGE_READWRITE |
+                            PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE)))
+    {
+        return 0;
+    }
+    const uintptr_t regionEnd = (uintptr_t)region.BaseAddress + region.RegionSize;
+    uintptr_t words = (regionEnd - (uintptr_t)sp) / sizeof(uintptr_t);
+    if (words > 512)
+    {
+        words = 512;
+    }
+    for (uintptr_t index = 0; index < words; index++)
+    {
+        const uintptr_t value = sp[index];
+        if (value > moduleBase + 0x1000 && value < moduleEnd && !samp_lookup(value))
+        {
+            return (uint32_t)(value - moduleBase);
+        }
+    }
+    return 0;
+}
