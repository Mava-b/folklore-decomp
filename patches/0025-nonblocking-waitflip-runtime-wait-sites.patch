 {
@@ -610,13 +615,58 @@ void cellGcmSetFlipMode(u32 mode)
 /* NID: 0xC44D8F34 */
 void cellGcmSetWaitFlip(void)
 {
+#ifdef _WIN32
+    __declspec(dllimport) void __stdcall Sleep(unsigned long);
+#endif  /* elsewhere: runtime/platform/win32_compat.h */
+    /* GCM_WAITFLIP_NONBLOCKING=1: return at once, as the hardware call does.
+     * On a PS3 this only puts a wait into the command buffer -- the RSX holds
+     * the next frame's commands until the flip is shown, while the PPU goes on
+     * building that frame. Blocking the calling thread here instead serializes
+     * every frame's CPU work with the next vblank: Folklore's main thread spent
+     * a third of each beach frame in this wait. The drain already executes the
+     * stream in order and presents at each flip marker, so the frame shown is
+     * the same; the title paces itself on its own labels and the vblank count.
+     * Off by default -- a title that relies on this to throttle (see below)
+     * would otherwise run unpaced. */
+    { static int nonBlocking = -1;
+      if (nonBlocking < 0)
+      {
+          nonBlocking = getenv("GCM_WAITFLIP_NONBLOCKING") ? 1 : 0;
+      }
+      if (nonBlocking)
+      {
+          return;
+      } }
+    /* GCM_WAITFLIP_DEPTH=<n> (1 is the useful value): wait only until no more
+     * than n flips are still waiting for the screen. On a PS3 the call queues
+     * an RSX wait and the PPU carries on, so the title builds frame N+1 while
+     * frame N waits for its vblank; it is held back only when the GPU side
+     * falls behind. Blocking until the flip just requested is shown (below)
+     * serializes every frame's CPU work with the next vblank instead. Not
+     * returning at once keeps the pacing: a title whose logos count frames ran
+     * them at 160 fps with GCM_WAITFLIP_NONBLOCKING. */
+    { static int depth = -1;
+      if (depth < 0)
+      {
+          const char* depthText = getenv("GCM_WAITFLIP_DEPTH");
+          depth = depthText ? atoi(depthText) : 0;
+          if (depth < 0)
+          {
+              depth = 0;
+          }
+      }
+      if (depth > 0)
+      {
+          for (int waited = 0; waited < 100 && (int)(s_flips_issued - s_flips_shown) > depth; waited++)
+          {
+              Sleep(1);
+          }
+          return;
+      } }
     /* Block until the pending flip completes (the present thread marks it done
      * via cellGcmTickFlip, ~once per display refresh). This throttles the title
      * to vsync; without it the guest loops unthrottled and many frames batch
      * into a single host present -> the console text stacks/duplicates. */
-#ifdef _WIN32
-    __declspec(dllimport) void __stdcall Sleep(unsigned long);
-#endif  /* elsewhere: runtime/platform/win32_compat.h */
     for (int i = 0; i < 64 && s_flip_status == CELL_GCM_FLIP_STATUS_WAITING; i++)
         Sleep(1);
     s_flip_status = CELL_GCM_FLIP_STATUS_DONE;
@@ -764,6 +814,11 @@ void cellGcmTickVBlank(void) { s_vblank_count++; GCM_PENDING_SET(1); }
  * the callback IS the flip interrupt -- no flip, no callback. */
 void cellGcmTickFlip(void)
 {
+    /* One flip reaches the screen per vblank, once the drain has reached it. */
+    if (s_flips_shown < s_flips_issued && s_flips_shown < s_flip_request_count)
+    {
+        s_flips_shown++;
+    }
     if (s_flip_status == CELL_GCM_FLIP_STATUS_WAITING)
         GCM_PENDING_SET(2);
 }
