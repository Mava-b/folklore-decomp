+    /* LD_SKIP_SAMPLING=<hex offset>[:<vertex count>]: drop draws whose
+     * fragment program samples a texture at that offset (and, when given,
+     * that draw that many vertices). Debug only -- removing a pass shows
+     * what it contributes. The vertex count tells apart draws that read the
+     * same surface: a full-screen copy (6) from an effect mesh.
+     *
+     * LD_PROBE_SAMPLING=<hex offset>[:<vertex count>]: log the draws that
+     * would match, each shader once, with the LD_HLSL_DUMP file its HLSL is
+     * in. The CSV's pso_key folds in the fragment program's inline
+     * constants, so an animated effect gets a new key every frame while the
+     * shader -- and its dump file, named by the first key -- stays the
+     * same; this names that file. */
+    { static int parsed = 0;
+      static int64_t skipOffset = -1, probeOffset = -1;
+      static u32 skipVerts = 0, probeVerts = 0;
+      if (!parsed) {
+          parsed = 1;
+          const char* skipText = getenv("LD_SKIP_SAMPLING");
+          if (skipText) {
+              char* rest = NULL;
+              skipOffset = (int64_t)strtoul(skipText, &rest, 16);
+              if (rest && *rest == ':') {
+                  skipVerts = (u32)strtoul(rest + 1, NULL, 10);
+              }
+          }
+          const char* probeText = getenv("LD_PROBE_SAMPLING");
+          if (probeText) {
+              char* rest = NULL;
+              probeOffset = (int64_t)strtoul(probeText, &rest, 16);
+              if (rest && *rest == ':') {
+                  probeVerts = (u32)strtoul(rest + 1, NULL, 10);
+              }
+          }
+      }
+      if (skipOffset >= 0 || probeOffset >= 0) {
+          int skipThis = 0;
+          for (u32 unit = 0; unit < 16; unit++) {
+              if (!((g_ld_current_pso.ps_unit_mask >> unit) & 1u)) {
+                  continue;
+              }
+              rsx_dsp_texture sampled;
+              rsx_dsp_get_texture(&g.rsx, unit, &sampled);
+              if (!sampled.enabled) {
+                  continue;
+              }
+              if (skipOffset >= 0 && sampled.offset == (u32)skipOffset && (!skipVerts || n_tri == skipVerts)) {
+                  skipThis = 1;
+              }
+              if (probeOffset >= 0 && sampled.offset == (u32)probeOffset && (!probeVerts || n_tri == probeVerts)) {
+                  static u64 loggedKeys[32];
+                  static u32 loggedCount = 0;
+                  int seen = 0;
+                  for (u32 index = 0; index < loggedCount; index++) {
+                      if (loggedKeys[index] == g_ld_current_pso.dump_key) {
+                          seen = 1;
+                      }
+                  }
+                  if (!seen && loggedCount < 32) {
+                      loggedKeys[loggedCount++] = g_ld_current_pso.dump_key;
+                      fprintf(stderr,
+                              "[probe-sampling] frame %u: unit %u samples 0x%X (format 0x%02X), %u vertices, "
+                              "prim %u, shader hlsl_%016llx (units 0x%X, draw key %016llx)\n",
+                              g_ld_frames, unit, sampled.offset, sampled.format, n_tri, prim,
+                              (unsigned long long)g_ld_current_pso.dump_key, g_ld_current_pso.ps_unit_mask,
+                              (unsigned long long)live_legacy_pso_key());
+                      fflush(stderr);
+                  }
+              }
+          }
+          if (skipThis) {
+              return;
+          }
+      } }
