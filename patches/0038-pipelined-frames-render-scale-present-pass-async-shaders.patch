+    "    float lumaCenter = dot(colorCenter, float3(0.299, 0.587, 0.114));\n"
+    "    float lumaDown = lumaAt(uv + float2(0.0, texel.y));\n"
+    "    float lumaUp = lumaAt(uv - float2(0.0, texel.y));\n"
