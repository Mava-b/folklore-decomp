  * exactly as it does for the 0xFEAD words a statically-linked libgcm emits.
  * Returns 0 when there is no room or ctx is not a mapped command buffer. */
+/* Back-pressure on the runtime's command ring.
+ *
+ * On a PS3 the RSX reads the ring while the PPU fills it, and libgcm's
+ * reserve stops the PPU short of `get`. Here nothing did: Folklore writes a
+ * whole frame and publishes `put` once, just after its flip, and its ring is
+ * 2 MB. At the original 30 fps the game sleeps out every frame and the drain
+ * has read everything by the time the next one starts. Uncapped,
+ * cellGcmSetWaitFlip lets it run a frame ahead, and at the beach two frames
+ * do not fit: the next frame overwrote commands the drain had not read yet.
+ * The drain then decoded vertex data as commands, gave up on the stream and
+ * skipped to `put` -- frames lost their flips (the 100 ms WaitFlip resyncs,
+ * the fall to 8 fps) and draws ran with the wrong state (white fans, a
+ * blown-out sky).
+ *
+ * The fix is the hardware's: the ring's `end` as the guest sees it is kept
+ * just short of the oldest command the drain has not read. The guest's own
+ * reserve check (current + n > end) then calls the buffer-full callback when
+ * it catches up, and the callback waits for the drain to move on
+ * (cellGcm_fifo_reserve). While the drain is behind the guest in the guest's
+ * own lap of the ring the limit is the real end. */
+static u32 s_ring_ctx = 0;          /* the context cellGcmSetupContext built */
+static u32 s_ring_begin = 0;
+static u32 s_ring_end = 0;          /* the real end; ctx->end may be lower */
+/* Where the frame being written began, and the largest recent frame. */
+static u32 s_ring_frame_start = 0;
+static u32 s_ring_frame_peak = 0;
+/* How far short of the drain the guest is stopped. */
+#define GCM_RING_GUARD 0x100u
+/* How long the guest may be held before it is let go regardless... */
+#define GCM_RING_WAIT_CAP_MS 500
+/* ...and how long the drain may sit still meanwhile: it can be parked on a
+ * label the guest only writes later. Longer than the present thread's
+ * slowest frame, during which the drain does not move either. */
+#define GCM_RING_STALL_MS 150
+
+/* The runtime's ring, unchanged since setup, still with the runtime's
+ * buffer-full callback. */
+static int gcm_ring_is_runtime(u32 ctx)
+{
+    if (!ctx || ctx != s_ring_ctx || s_ring_end <= s_ring_begin)
+    {
+        return 0;
+    }
+    if (vm_read32(ctx + 0x0) != s_ring_begin)
+    {
+        return 0;
+    }
+    const u32 callbackOpd = vm_read32(ctx + 0xC);
+    return callbackOpd && vm_read32(callbackOpd) == GCM_FIFO_CALLBACK_SENTINEL_EA;
+}
+
+/* How far the guest may write from writePos without reaching a command the
+ * drain has not read. */
+static u32 gcm_ring_soft_end(u32 writePos)
+{
+    const u32 drainedEa = g_gcm_fifo_drained_ea;
+    /* Outside the ring (the drain is in a CALL target), or at or behind the
+     * guest in its own lap: up to the real end. */
+    if (drainedEa < s_ring_begin || drainedEa > s_ring_end + GCM_RECYCLE_SLACK || drainedEa <= writePos)
+    {
+        return s_ring_end;
+    }
+    /* Still in the previous lap, ahead of the guest in address: everything
+     * from drainedEa on is unread. */
+    u32 limit = drainedEa > GCM_RING_GUARD ? drainedEa - GCM_RING_GUARD : 0;
+    if (limit > s_ring_end)
+    {
+        limit = s_ring_end;
+    }
+    if (limit < writePos)
+    {
+        limit = writePos;
+    }
+    return limit;
+}
+
+static void gcm_ring_setup(u32 ctx, u32 begin, u32 end)
+{
+    s_ring_ctx = ctx;
+    s_ring_begin = begin;
+    s_ring_end = end;
+    s_ring_frame_start = begin;
+    s_ring_frame_peak = 0;
+}
+
+static void gcm_ring_publish_end(u32 ctx, u32 writePos)
+{
+    vm_write32(ctx + 0x4, gcm_ring_soft_end(writePos));
+}
+
+/* Record the frame that ends at frameEnd and return the room its successor
+ * is expected to need: the recent peak plus a quarter, plus 64 KB. */
+static u32 gcm_ring_note_frame(u32 frameEnd)
+{
+    u32 frameStart = s_ring_frame_start;
+    if (frameStart < s_ring_begin || frameStart > s_ring_end)
+    {
+        frameStart = s_ring_begin;
+    }
+    /* A frame the buffer-full callback wrapped spans the ring's tail and head. */
+    const u32 frameBytes = frameEnd >= frameStart ? frameEnd - frameStart
+                                                  : (s_ring_end - frameStart) + (frameEnd - s_ring_begin);
+    u32 peakBytes = s_ring_frame_peak - s_ring_frame_peak / 64u;
+    if (frameBytes > peakBytes)
+    {
+        peakBytes = frameBytes;
+    }
+    s_ring_frame_peak = peakBytes;
+    g_gcm_ring_frame_peak = peakBytes;
+    g_gcm_ring_bytes = s_ring_end - s_ring_begin;
+    return peakBytes + peakBytes / 4u + 0x10000u;
+}
+
+/* The buffer-full callback for the runtime's ring: the guest needs
+ * countWords more words at `current`. Returns 1 when the room was found
+ * short of the real end (waiting for the drain if it had to); 0 when the
+ * ring has to wrap. */
+static int gcm_ring_make_room(u32 ctx, u32 countWords)
+{
+    const u32 current = vm_read32(ctx + 0x8);
+    if (current < s_ring_begin || current > s_ring_end)
+    {
+        return 0;
+    }
+    if (countWords > 0x40000u)
+    {
+        countWords = 0x40000u;
+    }
+    /* Ask for a little more than this one reservation, so a guest chasing
+     * the drain is not back here on every command. */
+    u32 requiredBytes = countWords * 4u + 0x4000u;
+    if (current + requiredBytes > s_ring_end)
+    {
+        requiredBytes = countWords * 4u + 16u;
+        if (current + requiredBytes > s_ring_end)
+        {
+            return 0;
+        }
+    }
+    u64 waitBegin = 0;
+    int waitedMs = 0;
+    int stillMs = 0;
+    u32 lastDrainedEa = g_gcm_fifo_drained_ea;
+    while (gcm_ring_soft_end(current) < current + requiredBytes)
+    {
+        const u32 drainedEa = g_gcm_fifo_drained_ea;
+        if (drainedEa != lastDrainedEa)
+        {
+            lastDrainedEa = drainedEa;
+            stillMs = 0;
+        }
+        if (waitedMs >= GCM_RING_WAIT_CAP_MS || stillMs >= GCM_RING_STALL_MS)
+        {
+            static int reports = 0;
+            if (reports < 8)
+            {
+                reports++;
+                fprintf(stderr, "[gcm] ring back-pressure: drain still at 0x%08X, %u bytes past the guest at 0x%08X, after %d ms; letting the guest go\n",
+                        drainedEa, drainedEa - current, current, waitedMs);
+            }
+            vm_write32(ctx + 0x4, s_ring_end);
+            if (waitBegin)
+            {
+                g_gcm_perf_ring_wait_ns += gcm_perf_now_ns() - waitBegin;
+            }
+            return 1;
+        }
+        if (!waitBegin)
+        {
+            waitBegin = gcm_perf_now_ns();
+        }
+        Sleep(1);
+        waitedMs++;
+        stillMs++;
+    }
+    if (waitBegin)
+    {
+        g_gcm_perf_ring_wait_ns += gcm_perf_now_ns() - waitBegin;
+    }
+    gcm_ring_publish_end(ctx, current);
+    return 1;
+}
+
+/* The buffer-full callback (hle_gcm_callback): the guest needs countWords
+ * more words at ctx->current. On the runtime's ring that is usually the soft
+ * end -- wait for the drain and raise it -- and otherwise the real end, where
+ * the ring wraps. */
+void cellGcm_fifo_reserve(u32 ctx_ea, u32 countWords)
+{
+    const int runtimeRing = gcm_ring_is_runtime(ctx_ea);
+    if (runtimeRing && gcm_ring_make_room(ctx_ea, countWords))
+    {
+        return;
+    }
+    cellGcm_fifo_recycle(ctx_ea);
+    if (runtimeRing)
+    {
+        gcm_ring_publish_end(ctx_ea, vm_read32(ctx_ea + 0x8));
+    }
+}
+
