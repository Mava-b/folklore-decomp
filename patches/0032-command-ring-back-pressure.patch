@@ -2610,13 +2841,44 @@ static int gcm_flip_into_fifo(u32 ctx, u32 bufferId)
     const u32 begin = vm_read32(ctx), io_begin = gcm_ea2io(begin);
     const u32 cb_opd = vm_read32(ctx + 0xC);
