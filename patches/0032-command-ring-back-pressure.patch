+    /* The runtime's ring may show the guest a lower `end` (the drain's
+     * position, see gcm_ring_soft_end); the marker always fits under that,
+     * GCM_RING_GUARD short of the drain. */
+    const u32 realEnd = gcm_ring_is_runtime(ctx) ? s_ring_end : end;
