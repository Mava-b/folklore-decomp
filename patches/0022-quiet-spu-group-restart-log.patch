 #include <stdlib.h>
 #include <string.h>
 
+/* The per-run start/stop lines repeat for as long as a title restarts its SPU
+ * group per unit of work (Folklore's audio: ~185 a second), each flushed
+ * through the console. Log the first 16, then every 4096th;
+ * PS3_SPU_LOG_ALL=1 logs them all. */
+static int spu_run_log_wanted(volatile unsigned* counter)
+{
+    static int logAll = -1;
+    if (logAll < 0)
+    {
+        logAll = getenv("PS3_SPU_LOG_ALL") ? 1 : 0;
+    }
+    const unsigned count = (*counter)++;
+    return logAll || count < 16u || (count % 4096u) == 0u;
+}
+
