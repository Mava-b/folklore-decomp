+    InterlockedExchange(&g_ld_hdr_paper_white_nits, (LONG)paperWhiteNits);
+    InterlockedExchange(&g_ld_hdr_highlight_percent, (LONG)highlightPercent);
+    InterlockedExchange(&g_ld_hdr_enabled, enabled ? 1 : 0);
