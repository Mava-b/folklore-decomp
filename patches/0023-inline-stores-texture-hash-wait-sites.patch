+/* Where a guest thread is when it is NOT running lifted code: the nearest
+ * lifted function on its stack, split by whether the RIP is in ntdll (it is
+ * waiting -- a lock, an event, a sleep) or in other host code (the runtime is
+ * doing work on its behalf: a store helper, an HLE, the renderer). The thread
+ * table says a thread is 30% idle; this says idle in WHICH guest call, which
+ * is what tells a frame-pacing wait from a lock convoy. */
+#define SAMP_SITES 1024
+static uint32_t s_site_tid[SAMP_SITES];
+static uint32_t s_site_fn[SAMP_SITES];
+static uint8_t  s_site_wait[SAMP_SITES];
+static uint64_t s_site_ct[SAMP_SITES];
+
+static void samp_site_hit(uint32_t tid, uint32_t guestFunction, int waiting)
+{
+    const uint32_t key = (guestFunction >> 2) ^ (tid * 2654435761u) ^ (uint32_t)waiting;
+    for (uint32_t probe = 0; probe < SAMP_SITES; probe++)
+    {
+        const uint32_t slot = (key + probe) % SAMP_SITES;
+        if (s_site_ct[slot] == 0)
+        {
+            s_site_tid[slot] = tid;
+            s_site_fn[slot] = guestFunction;
+            s_site_wait[slot] = (uint8_t)waiting;
+            s_site_ct[slot] = 1;
+            return;
+        }
+        if (s_site_tid[slot] == tid && s_site_fn[slot] == guestFunction &&
+            s_site_wait[slot] == (uint8_t)waiting)
+        {
+            s_site_ct[slot]++;
+            return;
+        }
+    }
+}
+
+static void samp_site_report(void)
+{
+    for (int pass = 0; pass < 2; pass++)
+    {
+        for (int rank = 0; rank < 16; rank++)
+        {
+            uint64_t best = 0;
+            int bestSlot = -1;
+            for (int slot = 0; slot < SAMP_SITES; slot++)
+            {
+                if (s_site_wait[slot] == (uint8_t)(pass == 0) && s_site_ct[slot] > best)
+                {
+                    best = s_site_ct[slot];
+                    bestSlot = slot;
+                }
+            }
+            if (bestSlot < 0 || !best)
+            {
+                break;
+            }
+            fprintf(stderr, "[samp] %s tid %-6u under %s%08X  (%llu)\n",
+                    pass == 0 ? "wait" : "host", s_site_tid[bestSlot],
+                    (s_site_fn[bestSlot] & 0x80000000u) ? "spu_LS_" : "func_",
+                    s_site_fn[bestSlot] & 0x7FFFFFFFu, (unsigned long long)best);
+            s_site_ct[bestSlot] = 0;
+        }
+    }
+    memset(s_site_ct, 0, sizeof s_site_ct);
+}
+
