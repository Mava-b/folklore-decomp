diff --git a/runtime/ppu/ppu_fs.cpp b/runtime/ppu/ppu_fs.cpp
index 0992a2b..3aa8404 100644
--- a/runtime/ppu/ppu_fs.cpp
+++ b/runtime/ppu/ppu_fs.cpp
@@ -786,8 +786,53 @@ static void cellFsMkdir(ppu_context* ctx)
     if (getenv("PS3_FSLOG")) fprintf(stderr, "[fs] mkdir '%s' -> '%s' (%s)\n", gpath, hpath, r == 0 ? "OK" : "FAIL");
     ctx->gpr[3] = CELL_OK;   /* existing dir is benign for boot */
 }
-static void cellFsRmdir(ppu_context* ctx)  { ctx->gpr[3] = CELL_OK; }
-static void cellFsUnlink(ppu_context* ctx) { ctx->gpr[3] = CELL_OK; }
+/* cellFsRmdir / cellFsUnlink / cellFsRename were no-op stubs answering CELL_OK
+ * (Rename was not handled here at all, so it fell through to libs/filesystem's
+ * cellFsRename, whose path mapping ignores PS3_HDD0_ROOT / PS3_HDD1_ROOT).
+ * Folklore deletes TMP_HDD_COPY.DAT -- its "install in progress" marker -- when
+ * the HDD install finishes; the stub left it behind and every later boot said
+ * "Game data is corrupt". All three now act on the host, through host_path()
+ * like every other call in this file. */
+static int host_errno_to_cell(int err)
+{
+    return (err == ENOENT) ? CELL_FS_ENOENT : CELL_FS_EIO;
+}
+static void cellFsRmdir(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    host_path(hpath, sizeof hpath, gpath);
+#ifdef _WIN32
+    int r = _rmdir(hpath);
+#else
+    int r = rmdir(hpath);
+#endif
+    if (getenv("PS3_FSLOG")) fprintf(stderr, "[fs] rmdir '%s' -> '%s' (%s)\n", gpath, hpath, r == 0 ? "OK" : "FAIL");
+    ctx->gpr[3] = (r == 0) ? CELL_OK : (uint64_t)(int64_t)host_errno_to_cell(errno);
+}
+static void cellFsUnlink(ppu_context* ctx)
+{
+    char gpath[1024], hpath[1100];
+    guest_strcpy(gpath, (uint32_t)ctx->gpr[3], sizeof gpath);
+    host_path(hpath, sizeof hpath, gpath);
+    int r = remove(hpath);
+    fprintf(stderr, "[fs] unlink '%s' -> '%s' (%s)\n", gpath, hpath, r == 0 ? "OK" : "FAIL");
+    ctx->gpr[3] = (r == 0) ? CELL_OK : (uint64_t)(int64_t)host_errno_to_cell(errno);
+}
+static void cellFsRename(ppu_context* ctx)
+{
+    char gfrom[1024], gto[1024], hfrom[1100], hto[1100];
+    guest_strcpy(gfrom, (uint32_t)ctx->gpr[3], sizeof gfrom);
+    guest_strcpy(gto,   (uint32_t)ctx->gpr[4], sizeof gto);
+    host_path(hfrom, sizeof hfrom, gfrom);
+    host_path(hto,   sizeof hto,   gto);
+    /* POSIX rename replaces an existing target; Windows' does not. */
+    struct stat st;
+    if (stat(hto, &st) == 0 && (st.st_mode & S_IFMT) != S_IFDIR) remove(hto);
+    int r = rename(hfrom, hto);
+    fprintf(stderr, "[fs] rename '%s' -> '%s' (%s)\n", gfrom, gto, r == 0 ? "OK" : "FAIL");
+    ctx->gpr[3] = (r == 0) ? CELL_OK : (uint64_t)(int64_t)host_errno_to_cell(errno);
+}
 static void cellFsFsync(ppu_context* ctx)
 {
     int fd = (int)(uint32_t)ctx->gpr[3];
@@ -918,6 +963,7 @@ extern "C" void ppu_fs_register(void)
     ps3_hle_register_ctx(ps3_compute_nid("cellFsMkdir"),    "cellFsMkdir",    cellFsMkdir);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsRmdir"),    "cellFsRmdir",    cellFsRmdir);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsUnlink"),   "cellFsUnlink",   cellFsUnlink);
+    ps3_hle_register_ctx(ps3_compute_nid("cellFsRename"),   "cellFsRename",   cellFsRename);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsFsync"),    "cellFsFsync",    cellFsFsync);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsGetFreeSize"),   "cellFsGetFreeSize",   cellFsGetFreeSize);
     ps3_hle_register_ctx(ps3_compute_nid("cellFsChmod"),         "cellFsChmod",         cellFsChmod);
