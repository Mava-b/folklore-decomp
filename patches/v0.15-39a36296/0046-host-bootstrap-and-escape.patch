     case WM_KEYDOWN:
+        /* Escape quits only when PS3_ESCAPE_QUITS is set: games use it
+         * themselves (Folklore's engine menu closes on it), and quitting the
+         * whole game on it lost progress. The window's close button and
+         * Alt+F4 still quit. */
         if (wp == VK_ESCAPE) {
-            s_state.window_closed = 1;
