From: Folklore port <noreply@localhost>
Subject: [PATCH 0009] Eight resident SPU code regions; log failing video AUs

1. spu_context.resident_code grows from 4 to 8 slots
   (SPU_RESIDENT_CODE_SLOTS). With its sound running, Folklore's jm2 keeps
   five job binaries in local store at once (0x4C00, 0x12000, 0x18400,
   0x1AC00, 0x1E400).
2. cellVdec: an AU the decoder rejects is logged with its address, size,
   FNV-1a hash and first bytes, to tell corrupted input from a decoder that
   rejects good input.

diff --git a/libs/codec/cellVdec.c b/libs/codec/cellVdec.c
index e129ed2..34614a6 100644
--- a/libs/codec/cellVdec.c
+++ b/libs/codec/cellVdec.c
@@ -297,9 +297,24 @@ s32 cellVdecDecodeAu(CellVdecHandle handle, s32 mode, const CellVdecAuInfo* auIn
         v->auCount++;
         v->aus[v->auCount % VDEC_AU_RING] = au;
         v->newPics = 0;
-        if (au.size)   /* an empty packet would mean end of stream to FFmpeg */
-            vdec_ff_decode(v->ff, vm_ptr8(au.startAddr), au.size, v->auCount,
-                           vdec_on_picture, v);
+        if (au.size) { /* an empty packet would mean end of stream to FFmpeg */
+            int rc = vdec_ff_decode(v->ff, vm_ptr8(au.startAddr), au.size, v->auCount,
+                                    vdec_on_picture, v);
+            /* Say what the failing AU held, so it can be checked against the
+             * file: corrupted input and a decoder that rejects good input
+             * need different fixes. */
+            if (rc < 0) {
+                static int s_n;
+                if (s_n++ < 12) {
+                    const u8* p = vm_ptr8(au.startAddr);
+                    u64 hash = 1469598103934665603ull;
+                    for (u32 i = 0; i < au.size; i++) { hash ^= p[i]; hash *= 1099511628211ull; }
+                    fprintf(stderr, "[cellVdec]   AU %u at 0x%08X size %u fnv=%016llX head=%02X%02X%02X%02X %02X%02X%02X%02X\n",
+                            v->auCount, au.startAddr, au.size, (unsigned long long)hash,
+                            p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7]);
+                }
+            }
+        }
         vdec_notify(handle, CELL_VDEC_MSG_TYPE_AUDONE, CELL_OK);
         vdec_notify_new_pics(handle);
         return CELL_OK;
