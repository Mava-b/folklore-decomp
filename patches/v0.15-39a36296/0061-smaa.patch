+    }
+    slots[0] = firstSlot;
+    slots[1] = secondSlot;
+    slots[2] = thirdSlot;
+    if (g.srv_ring_used >= ld_srv_end())
+    {
+        ld_flush(LD_FLUSH_DESCRIPTOR_RING);
+        if (!g.ready)
+        {
+            return 0;
+        }
+        g.srv_ring_used = ld_srv_base();
+    }
+    const D3D12_GPU_DESCRIPTOR_HANDLE table = srv_table(slots);
+    if (!table.ptr)
+    {
+        return 0;
+    }
