+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 1, table);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
