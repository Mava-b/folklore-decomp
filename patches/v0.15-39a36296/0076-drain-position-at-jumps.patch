+/* Where the drain has read up to, for the guest's write limit
+ * (gcm_ring_soft_end). Inside a CALL the position that matters is the
+ * return point in the ring: everything after it there is still unread, so
+ * the guest must not be let past it while the drain is away in the called
+ * buffer (a position outside the ring would let it write to the real end). */
+static void gcm_note_drained_position(u32 ea)
+{
+    if (s_fifo_calloff)
+    {
+        const u32 returnEa = gcm_io2ea(s_fifo_calloff);
+        if (returnEa)
+        {
+            ea = returnEa;
+        }
+    }
+    if (ea)
+    {
+        g_gcm_fifo_drained_ea = ea;
+    }
+}
