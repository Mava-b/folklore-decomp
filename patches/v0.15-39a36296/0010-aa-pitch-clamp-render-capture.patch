     return rsx_dsp_reg(rsx, M_CLEAR_DEPTH_VALUE);
 }
 
+/* Bytes per pixel of a SURFACE_FORMAT colour format (0 = unknown). */
+static u32 surface_color_bytes(u32 colorFormat)
+{
+    switch (colorFormat) {
+    case 0x1: case 0x2: case 0x3: case 0xA:
+        return 2u;
+    case 0x9:
+        return 1u;
+    case 0xB:
+        return 8u;
+    case 0xC:
+        return 16u;
+    case 0x4: case 0x5: case 0x8: case 0xD: case 0xE: case 0xF: case 0x10:
+        return 4u;
+    default:
+        return 0u;
+    }
+}
+
+/* An antialiased linear surface is only as wide as its pitch holds.
+ *
+ * Folklore declares its 2x (DIAGONAL_CENTERED_2) scene targets with a
+ * 2560-pixel clip over a 10240-byte pitch and draws them through a
+ * 1280-pixel viewport: 2560 samples, which is all that memory can hold.
+ * clip x 2 gave a 5120-wide surface at the same address as the 2560-wide one
+ * the same buffer had been declared as before, so the scene went into one
+ * and the passes that sample it as a 2560x720 texture read the other (stale,
+ * or half empty) -- the dark layer over the player-select screen.
+ * PS3_RSX_NO_AA_PITCH_CLAMP=1 restores the unclamped width. */
+static u32 clamp_aa_width_to_pitch(u32 sampleWidth, u32 colorFormat,
+                                   u32 rasterType, u32 pitch, u32 offset,
+                                   u32 clipPixels, u32 antialias)
+{
+    static int disabled = -1;
+    static u32 clampLogs = 0;
+    if (disabled < 0) {
+        disabled = getenv("PS3_RSX_NO_AA_PITCH_CLAMP") ? 1 : 0;
+    }
+    const u32 bytesPerPixel = surface_color_bytes(colorFormat);
+    if (disabled || rasterType == 2u || pitch < 64u || !bytesPerPixel) {
+        return sampleWidth;
+    }
+    const u32 pitchWidth = pitch / bytesPerPixel;
+    if (sampleWidth <= pitchWidth) {
+        return sampleWidth;
+    }
+    if (clampLogs < 16u) {
+        clampLogs++;
+        fprintf(stderr,
+                "[surf-aa-clamp] 0x%X clip=%u aa=%u -> %u samples exceeds pitch %u "
+                "(fmt 0x%X); using %u\n",
+                offset, clipPixels, antialias, sampleWidth, pitch, colorFormat,
+                pitchWidth);
+    }
+    return pitchWidth;
+}
