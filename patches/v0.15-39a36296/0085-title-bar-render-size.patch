+int rsx_live_draw_get_render_size(u32* renderWidth, u32* renderHeight, u32* outputWidth, u32* outputHeight)
+{
+    if (!g.ready || g.width == 0u || g.height == 0u)
+    {
+        return 0;
+    }
+    if (renderWidth)
+    {
+        *renderWidth = ld_scaled_x(g.width);
+    }
+    if (renderHeight)
+    {
+        *renderHeight = g.height * g.scale;
+    }
+    if (outputWidth)
+    {
+        *outputWidth = g.bb_w;
+    }
+    if (outputHeight)
+    {
+        *outputHeight = g.bb_h;
+    }
+    return 1;
+}
+
