 }
 
+/* A depth buffer read through a colour format.
+ *
+ * Soft particles and other depth-faded effects bind their zeta's address as
+ * an A8R8G8B8 texture and rebuild the depth from its bytes (Folklore's soul
+ * and capture-tether effects: dot(tex.wxy, weights)). An RSX Z24S8 word holds
+ * the depth in its upper 24 bits and the stencil in the lower 8, so read as
+ * ARGB the depth's high byte is A, its middle byte R, its low byte G and the
+ * stencil B. The host keeps that depth in a float snapshot, so each Sample()
+ * on a unit in `alias_mask` is rewritten to rebuild those bytes from it. */
+int rsx_fp_apply_zeta_alias(char* hlsl, u32 hlsl_size, u32 alias_mask, u32 cube_mask)
+{
+    if (!hlsl || !alias_mask)
+    {
+        return 0;
+    }
+    static const char helpers[] =
+        "float4 _rsx_zeta_argb(Texture2D depthTexture, SamplerState depthSampler, float2 coordinate) {\n"
+        "    float depth = saturate(depthTexture.SampleLevel(depthSampler, coordinate, 0).x);\n"
+        "    uint depthBits = (uint)round(depth * 16777215.0);\n"
+        "    return float4((float)((depthBits >> 8) & 255u), (float)(depthBits & 255u), 0.0,\n"
+        "                  (float)((depthBits >> 16) & 255u)) / 255.0;\n"
+        "}\n";
+    int patched = 0;
+    for (u32 unit = 0; unit < 16; unit++)
+    {
+        if (!((alias_mask >> unit) & 1u) || ((cube_mask >> unit) & 1u))
+        {
+            continue;
+        }
+        char needles[2][48];
+        char replacements[2][64];
+        snprintf(needles[0], sizeof needles[0], "rsx_tex[%u].Sample(rsx_samp[%u],", unit, unit);
+        snprintf(needles[1], sizeof needles[1], "rsx_tex%u.Sample(rsx_samp[%u],", unit, unit);
+        snprintf(replacements[0], sizeof replacements[0], "_rsx_zeta_argb(rsx_tex[%u], rsx_samp[%u],", unit, unit);
+        snprintf(replacements[1], sizeof replacements[1], "_rsx_zeta_argb(rsx_tex%u, rsx_samp[%u],", unit, unit);
+        for (int spelling = 0; spelling < 2; spelling++)
+        {
+            const u32 needleLength = (u32)strlen(needles[spelling]);
+            const u32 replacementLength = (u32)strlen(replacements[spelling]);
+            for (;;)
+            {
+                char* site = strstr(hlsl, needles[spelling]);
+                if (!site)
+                {
+                    break;
+                }
+                const u32 used = (u32)strlen(hlsl);
+                if (used - needleLength + replacementLength + 1 > hlsl_size)
+                {
+                    return -1;
+                }
+                memmove(site + replacementLength, site + needleLength,
+                        used - (u32)(site - hlsl) - needleLength + 1);
+                memcpy(site, replacements[spelling], replacementLength);
+                patched++;
+            }
+        }
+    }
+    if (patched)
+    {
+        const u32 used = (u32)strlen(hlsl);
+        const u32 helperLength = (u32)strlen(helpers);
+        if (used + helperLength + 1 > hlsl_size)
+        {
+            return -1;
+        }
+        memmove(hlsl + helperLength, hlsl, used + 1);
+        memcpy(hlsl, helpers, helperLength);
+    }
+    return patched;
+}
