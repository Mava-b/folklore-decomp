+/* A zeta sampled through an A8R8G8B8 texture: rewrite each 2D Sample() on a
+ * unit in `alias_mask` to rebuild the Z24S8 bytes (A = depth high byte,
+ * R = middle, G = low, B = stencil) from the float depth snapshot bound
+ * there. Returns the number of call sites rewritten, or -1 when the buffer is
+ * too small. */
+int rsx_fp_apply_zeta_alias(char* hlsl, u32 hlsl_size, u32 alias_mask, u32 cube_mask);
