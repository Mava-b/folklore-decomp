+                     * in-FIFO flip showed twice: 120 presents a second for a
+                     * 60 fps title, half of them wasted). Consume the flag
+                     * with the count. */
+                    if (fc) {
+                        (void)cellGcm_take_flip_pending();
+                        present_guest_frame();
+                    } else {
+                        rsx_present_frame();
+                    }
                     last_flip = fc;
                 } else if (fc == 0) {
                     rsx_backend_present();
