@@ -972,9 +972,38 @@ static volatile LONG g_resv_locks[PPU_RESV_LOCKS];
  * vm_write* reads g_resv_store_active directly (a hot global) so the default-off
  * path costs one predictable branch. */
 extern "C" int g_resv_store_active = -1;   /* -1 uninit, 0 off, 1 on */
+/* An SPU committed a write to the 128-byte line at `line`: every PPU
+ * reservation inside it is lost, because that line is the PPU's reservation
+ * granule too (see spu_coh_break_ppu in spu_coherency.h). Runs under the
+ * lock-line lock, which ppu_stwcx32/ppu_stdcx64 also hold while they re-check
+ * the reservation and commit on an SPU-reserved line, so the SPU commit and
+ * the PPU store-conditional cannot interleave. PPU_RESV_LINE_OFF=1 restores
+ * the old word-only behaviour for A/B runs. */
+extern "C" void (*g_spu_break_ppu_resv_hook)(uint32_t line);
+static void ppu_resv_break_line(uint32_t line)
+{
+    long contextCount = g_resv_ctx_n;
+    if (contextCount > PPU_RESV_MAX)
+    {
+        contextCount = PPU_RESV_MAX;
+    }
+    for (long contextIndex = 0; contextIndex < contextCount; contextIndex++)
+    {
+        ppu_context* context = g_resv_ctxs[contextIndex];
+        if (context && context->reserve_addr < PPU_RESV_INVALID &&
+            ((uint32_t)context->reserve_addr & ~127u) == line)
+        {
+            context->reserve_addr = PPU_RESV_INVALID;
+        }
+    }
+}
 extern "C" void ppu_resv_register(ppu_context* c)
 {
     if (g_resv_store_active < 0) g_resv_store_active = getenv("PPU_RESV_STORE") ? 1 : 0;
+    if (!g_spu_break_ppu_resv_hook && !getenv("PPU_RESV_LINE_OFF"))
+    {
+        g_spu_break_ppu_resv_hook = ppu_resv_break_line;
+    }
     long i = _InterlockedExchangeAdd(&g_resv_ctx_n, 1);
     if (i < PPU_RESV_MAX) g_resv_ctxs[i] = c;
 }
