+/* Screen-width scene buffer. Folklore draws its 3D scene into 2560x720 --
+ * the PS3's 2x-wide anti-aliasing buffer, resolved to the 1280x720 screen by
+ * the depth-of-field pass -- so at a render scale of 3 on a 21:9 screen the
+ * scene, every transparent effect over it and its depth buffer are 10240x2160:
+ * twice the screen's pixels, the graphics card's main load in busy places
+ * (run-20261113-175149: 60-75 fps, 5-8 ms a frame waiting for the GPU). From
+ * a render scale of 2 that width buys little the render scale has not
+ * already, so with the setting on such a surface -- at least twice the
+ * canvas across and less than twice down -- takes half the canvas's
+ * horizontal scale: its host width is the screen's. Its zeta follows
+ * (zdepth_t.scale_x). Read once per run: surfaces keep their size. */
+static int ld_scene_screen_width_active(void)
+{
+    if (g_ld_scene_screen_width_fixed < 0)
+    {
+        g_ld_scene_screen_width_fixed = InterlockedCompareExchange(&g_ld_scene_screen_width, 0, 0) &&
+                                        (g.scale ? g.scale : 1u) >= 2u;
+        if (g_ld_scene_screen_width_fixed)
+        {
+            fprintf(stderr, "[live-draw] screen-width scene buffer: 2x-wide surfaces at half the horizontal "
+                            "render scale\n");
+        }
+    }
+    return g_ld_scene_screen_width_fixed;
+}
+
+static int ld_surface_halved(u32 guestWidth, u32 guestHeight)
+{
+    if (!guestWidth)
+    {
+        guestWidth = g.width;
+    }
+    if (!guestHeight)
+    {
+        guestHeight = g.height;
+    }
+    return ld_scene_screen_width_active() && ld_surface_is_canvas(guestWidth, guestHeight) &&
+           guestWidth >= 2u * g.width && guestHeight < 2u * g.height;
+}
+
 static float ld_surface_scale_x_for(u32 guestWidth, u32 guestHeight)
 {
-    return ld_surface_is_canvas(guestWidth, guestHeight) ? ld_canvas_scale_x() : 1.0f;
+    if (!ld_surface_is_canvas(guestWidth, guestHeight))
+    {
+        return 1.0f;
+    }
+    return ld_surface_halved(guestWidth, guestHeight) ? ld_canvas_scale_x() * 0.5f : ld_canvas_scale_x();
 }
 
 /* A guest-pixel length in a surface's host pixels: ld_surface_x across,
@@ -673,7 +724,18 @@
 
 static int ld_surface_is_canvas_scale(const surface_t* surface)
 {
-    return surface->scale == (g.scale ? g.scale : 1u) && surface->scale_x == ld_canvas_scale_x();
+    const float canvasScaleX = surface->halved ? ld_canvas_scale_x() * 0.5f : ld_canvas_scale_x();
+    return surface->scale == (g.scale ? g.scale : 1u) && surface->scale_x == canvasScaleX;
+}
+
+/* Whether a surface is widened for an ultrawide screen (its horizontal
+ * scale above its vertical one, a screen-width scene counted at its own
+ * width). */
+static int ld_surface_widened(const surface_t* surface)
+{
+    const float verticalScale = (float)(surface->scale ? surface->scale : 1u);
+    const float horizontalScale = surface->scale_x * (surface->halved ? 2.0f : 1.0f);
+    return horizontalScale > verticalScale * 1.01f;
 }
 
