+static void pad_hid_close(PadHidDevice* pad)
+{
+    if (pad->device != INVALID_HANDLE_VALUE)
+    {
+        CancelIo(pad->device);
+        CloseHandle(pad->device);
+    }
+    if (pad->ioEvent)
+    {
+        CloseHandle(pad->ioEvent);
+    }
+    memset(pad, 0, sizeof(*pad));
+    pad->device = INVALID_HANDLE_VALUE;
+}
