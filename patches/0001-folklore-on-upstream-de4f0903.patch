+static u16 pad_ds3_sensor_word(const u8* bytes)
+{
+    u16 value = (u16)(bytes[0] | (bytes[1] << 8));
+    if (value > 1023u)
+    {
+        /* Big-endian on some driver; take whichever reading is in range. */
+        const u16 swapped = (u16)((bytes[0] << 8) | bytes[1]);
+        if (swapped <= 1023u)
+        {
+            value = swapped;
+        }
+        else
+        {
+            value = 1023u;
+        }
+    }
+    return value;
+}
