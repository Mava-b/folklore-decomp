+/* The key a pack file's name gives, or 0. */
+static u64 eng_mod_name_key(const char* name)
+{
+    u64 k = 0;
+    for (int i = 0; i < 16; i++) {
+        const int v = eng_hexval((unsigned char)name[i]);
