+typedef enum {
+    LD_COMPACT_EXPAND_OK = 1,
+    LD_COMPACT_EXPAND_DEGENERATE = 0,
+    LD_COMPACT_EXPAND_ALLOC = -1,
+    LD_COMPACT_EXPAND_PRIMITIVE = -2
+} ld_compact_expand_result;
+
+static void compact_vertex_copy(
+    u8* destination, u32 destination_vertex, u32 source_vertex)
+{
+    if (!dc.layout.stride)
+        return;
+    memcpy(
+        destination + (u64)destination_vertex * dc.layout.stride,
+        dc.compact_verts + (u64)source_vertex * dc.layout.stride,
+        dc.layout.stride);
+}
+
+static ld_compact_expand_result expand_compact_topology(
+    u32 prim, u8** expanded, u32* expanded_vertices, int* owned)
+{
+    *expanded = dc.compact_verts;
+    *expanded_vertices = 0;
+    *owned = 0;
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES:
+        *expanded_vertices = dc.n_verts - dc.n_verts % 3;
+        break;
+    case PRIM_TRIANGLE_STRIP: {
+        if (dc.n_verts < 3)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        if (!total)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = total;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc((size_t)total * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 0; i + 2 < count; i++) {
+                if (i & 1) {
+                    compact_vertex_copy(*expanded, write++, begin + i + 1);
+                    compact_vertex_copy(*expanded, write++, begin + i);
+                    compact_vertex_copy(*expanded, write++, begin + i + 2);
+                } else {
+                    compact_vertex_copy(*expanded, write++, begin + i);
+                    compact_vertex_copy(*expanded, write++, begin + i + 1);
+                    compact_vertex_copy(*expanded, write++, begin + i + 2);
+                }
+            }
+        }
+        break;
+    }
+    case PRIM_TRIANGLE_FAN: {
+        if (dc.n_verts < 3)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        if (!total)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = total;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc((size_t)total * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_verts, segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 1; i + 1 < count; i++) {
+                compact_vertex_copy(*expanded, write++, begin);
+                compact_vertex_copy(*expanded, write++, begin + i);
+                compact_vertex_copy(*expanded, write++, begin + i + 1);
+            }
+        }
+        break;
+    }
+    case PRIM_QUADS: {
+        const u32 quads = dc.n_verts / 4;
+        if (!quads)
+            return LD_COMPACT_EXPAND_DEGENERATE;
+        *expanded_vertices = quads * 6;
+        if (!dc.layout.stride)
+            break;
+        *expanded = (u8*)malloc(
+            (size_t)*expanded_vertices * dc.layout.stride);
+        if (!*expanded)
+            return LD_COMPACT_EXPAND_ALLOC;
+        *owned = 1;
+        u32 write = 0;
+        for (u32 quad = 0; quad < quads; quad++) {
+            const u32 base = quad * 4;
+            compact_vertex_copy(*expanded, write++, base);
+            compact_vertex_copy(*expanded, write++, base + 1);
+            compact_vertex_copy(*expanded, write++, base + 2);
+            compact_vertex_copy(*expanded, write++, base + 2);
+            compact_vertex_copy(*expanded, write++, base + 3);
+            compact_vertex_copy(*expanded, write++, base);
+        }
+        break;
+    }
+    default:
+        return LD_COMPACT_EXPAND_PRIMITIVE;
+    }
+    return *expanded_vertices
+        ? LD_COMPACT_EXPAND_OK : LD_COMPACT_EXPAND_DEGENERATE;
+}
+
+static u32 topology_index_count(u32 prim)
+{
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES:
+        return dc.n_source_refs - dc.n_source_refs % 3u;
+    case PRIM_TRIANGLE_STRIP:
+    case PRIM_TRIANGLE_FAN: {
+        u32 total = 0;
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            (void)begin;
+            if (count >= 3) total += (count - 2) * 3;
+        }
+        return total;
+    }
+    case PRIM_QUADS:
+        return (dc.n_source_refs / 4) * 6;
+    default:
+        return 0;
+    }
+}
+
+static u32 topology_vertex_index(u32 occurrence)
+{
+    return dc.refs_remapped
+        ? rsx_vertex_remap_index(&dc.ref_remap, occurrence)
+        : occurrence;
+}
+
+static void write_topology_indices(u32 prim, u32* indices)
+{
+    u32 write = 0;
+    const u32 segment_count = dc.n_cuts + 1;
+    switch (prim) {
+    case PRIM_TRIANGLES: {
+        const u32 count =
+            dc.n_source_refs - dc.n_source_refs % 3u;
+        for (u32 occurrence = 0; occurrence < count; occurrence++)
+            indices[write++] = topology_vertex_index(occurrence);
+        break;
+    }
+    case PRIM_TRIANGLE_STRIP:
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 0; i + 2 < count; i++) {
+                indices[write++] = topology_vertex_index(
+                    begin + i + (i & 1u));
+                indices[write++] = topology_vertex_index(
+                    begin + i + 1u - (i & 1u));
+                indices[write++] = topology_vertex_index(begin + i + 2u);
+            }
+        }
+        break;
+    case PRIM_TRIANGLE_FAN:
+        for (u32 segment = 0; segment < segment_count; segment++) {
+            u32 begin, count;
+            rsx_restart_segment_bounds(
+                dc.cuts, dc.n_cuts, dc.n_source_refs,
+                segment, &begin, &count);
+            if (count < 3) continue;
+            for (u32 i = 1; i + 1 < count; i++) {
+                indices[write++] = topology_vertex_index(begin);
+                indices[write++] = topology_vertex_index(begin + i);
+                indices[write++] = topology_vertex_index(begin + i + 1u);
+            }
+        }
+        break;
+    case PRIM_QUADS:
+        for (u32 quad = 0; quad < dc.n_source_refs / 4; quad++) {
+            const u32 base = quad * 4;
+            indices[write++] = topology_vertex_index(base);
+            indices[write++] = topology_vertex_index(base + 1u);
+            indices[write++] = topology_vertex_index(base + 2u);
+            indices[write++] = topology_vertex_index(base + 2u);
+            indices[write++] = topology_vertex_index(base + 3u);
+            indices[write++] = topology_vertex_index(base);
+        }
+        break;
+    }
+}
+
+/* Where the present thread's per-draw time goes, for the [fps] report:
+ * every draw's sink_end, split into vertex fetch, shader lookup, texture
+ * binding and the rest (constants, state and the draw call). */
+typedef struct
+{
+    u64 draws;
+    u64 totalTicks;
+    u64 fetchTicks;
+    u64 shaderTicks;
+    u64 bindTicks;
+    u64 uploadTicks;       /* vertex and index data into the upload ring */
+    u64 uploadBytes;
+    u64 constantTicks;     /* the constant buffer block */
+    u64 constantBytes;
+    u64 descriptorTicks;   /* SRV and sampler tables */
+    u64 setupTicks;        /* constant rings, targets and surfaces, before binding */
+    u64 submitTicks;       /* state, the draw call and its bookkeeping */
+} ld_draw_perf;
+
+static ld_draw_perf g_ld_draw_perf;
+
+static u64 ld_perf_ticks(void)
+{
+    LARGE_INTEGER value;
+    QueryPerformanceCounter(&value);
+    return (u64)value.QuadPart;
+}
+
+static double ld_perf_ticks_to_ms(u64 ticks)
+{
+    static double millisecondsPerTick = 0.0;
+    if (millisecondsPerTick == 0.0)
+    {
+        LARGE_INTEGER frequency;
+        QueryPerformanceFrequency(&frequency);
+        millisecondsPerTick = 1000.0 / (double)frequency.QuadPart;
+    }
+    return (double)ticks * millisecondsPerTick;
+}
+
+/* ---------------------------------------------------------------------------
+ * Repeat draws. The busy towns draw the same small mesh hundreds of times a
+ * frame -- capture-20261031-164309, in Doolin: 1471 of 2180 draws are one
+ * 24-vertex mesh with one texture, one pipeline and one state, each with its
+ * own transform constants (a plant, a stone, a lamp... placed again and
+ * again). Each went through the whole draw path: vertex fetch and cache
+ * check, shader key, texture binding, descriptor tables -- about 6-8 us,
+ * 9-10 ms a frame for these alone. When nothing but the transform constants
+ * has changed since the previous draw (the dispatcher's state_generation and
+ * vp_generation are the same, the same draw packets, the fragment program's
+ * instructions the same) the draw is the previous one again with new
+ * constants: the vertex data already uploaded, the pipeline, tables, targets
+ * and viewport are all reused, and only the constants are copied (the
+ * fragment program's too, which the game may patch in place). Not taken for
+ * draws that sample a render target, go into a display buffer (the HUD
+ * placement depends on the constants), were drawn by the soft-shadow
+ * passes, carry inline vertex data, or while a capture is being written.
+ * -----------------------------------------------------------------------*/
+#define LD_REPEAT_MAX_BATCHES 8u
+
+typedef struct {
+    int valid;
+    u32 epoch;
+    u32 frame;
+    u32 stateGeneration;
+    u32 vpGeneration;
+    u32 primitive;
+    u32 arrayCount;
+    u32 indexBatchCount;
+    batch_t arrays[LD_REPEAT_MAX_BATCHES];
+    batch_t indexBatches[LD_REPEAT_MAX_BATCHES];
+    ID3D12PipelineState* pipeline;
+    ld_pso_metadata metadata;
+    u64 fragmentHash;
+    D3D12_GPU_DESCRIPTOR_HANDLE textureTable;
+    D3D12_GPU_DESCRIPTOR_HANDLE samplerTable;
+    D3D12_GPU_DESCRIPTOR_HANDLE vertexTextureTable;
+    u32 vertexTextureMask;
+    D3D12_CPU_DESCRIPTOR_HANDLE renderTargets[4];
+    u32 renderTargetCount;
+    u32 targets[4];
+    D3D12_CPU_DESCRIPTOR_HANDLE depthStencil;
+    int haveDepthStencil;
+    u32 depthSlot;
+    int depthTest;
+    int depthWrite;
+    D3D12_VIEWPORT viewport;
+    D3D12_RECT scissor;
+    D3D12_VERTEX_BUFFER_VIEW vertexBuffer;
+    int haveVertexBuffer;
+    D3D12_INDEX_BUFFER_VIEW indexBuffer;
+    int indexed;
+    u32 vertexCount;
+    float viewportTransform[8];
+} ld_repeat_state;
+
+static ld_repeat_state g_ld_repeat;
+
+static u64 ld_repeat_fragment_hash(u32 location, u32 offset, u32 size)
+{
+    const u8* fragmentCode = size ? guest_ptr(location, offset, size) : NULL;
+    if (!fragmentCode)
+    {
+        return 0;
+    }
+    return ld_fp_constants_buffered() ? rsx_fp_structural_hash(fragmentCode, size, 1469598103934665603ull)
+                                      : fnv1a(fragmentCode, size, 1469598103934665603ull);
+}
+
+static int ld_repeat_draw(u32 primitive)
+{
+    ld_repeat_state* previous = &g_ld_repeat;
+    if (!previous->valid || !InterlockedCompareExchange(&g_ld_repeat_draws, 0, 0) || s_csv_file ||
+        previous->epoch != g_ld_ring_epoch || previous->frame != g_ld_frames ||
+        previous->stateGeneration != g.rsx.state_generation || previous->vpGeneration != g.rsx.vp_generation ||
+        previous->primitive != primitive || dc.inl || dc.n_arr != previous->arrayCount ||
+        dc.n_idx != previous->indexBatchCount)
+    {
+        return 0;
+    }
+    if (memcmp(dc.arr, previous->arrays, (size_t)dc.n_arr * sizeof(batch_t)) != 0 ||
+        memcmp(dc.idx, previous->indexBatches, (size_t)dc.n_idx * sizeof(batch_t)) != 0)
+    {
+        return 0;
+    }
+    const ld_pso_metadata* metadata = &previous->metadata;
+    if (ld_repeat_fragment_hash(metadata->fp_location, metadata->fp_offset, metadata->fp_size) !=
+        previous->fragmentHash)
+    {
+        return 0;
+    }
+    if (ld_fp_constants_buffered())
+    {
+        const u8* fragmentCode = guest_ptr(metadata->fp_location, metadata->fp_offset, metadata->fp_size);
+        if (!fragmentCode || rsx_fp_collect_constants(fragmentCode, metadata->fp_size, &g.fp_constants) < 0)
+        {
+            return 0;
+        }
+    }
+    /* Room for the constants without starting the rings over (that would
+     * invalidate everything reused here). */
+    u32 vertexConstantOffset = 0;
+    if (rsx_vertex_constant_ring_plan(g.cb_used, ld_cb_end(), CB_BLOCK_ALIGNED, &vertexConstantOffset) != 1)
+    {
+        return 0;
+    }
+    const u32 epochBefore = g_ld_ring_epoch;
+    u32 pixelConstantOffset = 0;
+    if (!ld_upload_pixel_constants(&pixelConstantOffset) || g_ld_ring_epoch != epochBefore || !g.ready)
+    {
+        return 0;
+    }
+    g.cb_used = vertexConstantOffset;
+    u8* constantBlock = g.cb_mapped + g.cb_used;
+    {
+        u32 constantFirst = metadata->const_first;
+        u32 constantCount = metadata->const_count;
+        if (constantFirst >= RSX_DSP_NUM_CONSTANTS || constantFirst + constantCount > RSX_DSP_NUM_CONSTANTS)
+        {
+            constantFirst = 0;
+            constantCount = RSX_DSP_NUM_CONSTANTS;
+        }
+        if (constantCount)
+        {
+            memcpy(constantBlock + (size_t)constantFirst * 16u, g.rsx.constants[constantFirst],
+                   (size_t)constantCount * 16u);
+        }
+        g_ld_draw_perf.constantBytes += (u64)constantCount * 16u;
+    }
+    memcpy(constantBlock + 512 * 16, previous->viewportTransform, sizeof(previous->viewportTransform));
+
+    g.list->lpVtbl->OMSetRenderTargets(g.list, previous->renderTargetCount, previous->renderTargets, FALSE,
+                                       previous->haveDepthStencil ? &previous->depthStencil : NULL);
+    ID3D12DescriptorHeap* heaps[] = {g.srv_heap, g.smp_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 2, heaps);
+    g.list->lpVtbl->SetPipelineState(g.list, previous->pipeline);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, g.rootsig_x);
+    g.list->lpVtbl->SetGraphicsRootConstantBufferView(g.list, 0, g.cb->lpVtbl->GetGPUVirtualAddress(g.cb) + g.cb_used);
+    if (ld_fp_constants_buffered())
+    {
+        g.list->lpVtbl->SetGraphicsRootConstantBufferView(
+            g.list, 4, g.ps_cb->lpVtbl->GetGPUVirtualAddress(g.ps_cb) + pixelConstantOffset);
+    }
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 1, previous->textureTable);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 2, previous->samplerTable);
+    if (previous->vertexTextureMask)
+    {
+        g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 3, previous->vertexTextureTable);
+    }
+    g.cb_used += CB_BLOCK_ALIGNED;
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &previous->viewport);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &previous->scissor);
+    g.list->lpVtbl->OMSetStencilRef(g.list, rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu);
+    ld_set_blend_factor();
+    if (previous->haveVertexBuffer)
+    {
+        g.list->lpVtbl->IASetVertexBuffers(g.list, 0, 1, &previous->vertexBuffer);
+    }
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    if (previous->indexed)
+    {
+        g.list->lpVtbl->IASetIndexBuffer(g.list, &previous->indexBuffer);
+        g.list->lpVtbl->DrawIndexedInstanced(g.list, previous->vertexCount, 1, 0, 0, 0);
+    }
+    else
+    {
+        g.list->lpVtbl->DrawInstanced(g.list, previous->vertexCount, 1, 0, 0);
+    }
+    g_ld_current_pso = previous->metadata;
+    for (u32 targetIndex = 0; targetIndex < previous->renderTargetCount; targetIndex++)
+    {
+        ld_surface_note_write(previous->targets[targetIndex], LD_SURFACE_WRITE_DRAW);
+    }
+    if (previous->depthSlot)
+    {
+        zdepth_t* depth = &g.zdepths[previous->depthSlot - 1];
+        depth->draws++;
+        if (previous->depthTest)
+        {
+            depth->depth_test_draws++;
+        }
+        if (previous->depthWrite)
+        {
+            depth->depth_write_draws++;
+        }
+        if (previous->depthTest && previous->depthWrite)
+        {
+            depth->depth_both_draws++;
+            depth->had_write = 1;
+        }
+    }
+    g_ld_stats.groups_executed++;
+    g_ld_repeat_hits++;
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Resident geometry. Every draw used to copy its vertices (and write its
+ * indices) into the per-frame upload ring, even when they came straight from
+ * the geometry cache unchanged: about 30 MB a frame in the boss fight
+ * (capture-20261102-161629), 2 ms of copying. A cached draw's vertices and
+ * indices now go once into a buffer that is kept from frame to frame, and
+ * later draws of the same cache entry use them where they are. When the
+ * buffer is full the GPU is waited for and it starts again from the
+ * beginning (every entry re-uploads on its next use). LD_RESIDENT_GEOMETRY=0
+ * turns it off.
+ * -------------------------------------------------------------------------*/
+#define LD_RESIDENT_BYTES (256u * 1024u * 1024u)
+
+static u32 g_ld_resident_generation = 1u;
+static u64 g_ld_resident_used = 0;
+static u64 g_ld_resident_reuses = 0;
+static u64 g_ld_resident_reused_bytes = 0;
+static u64 g_ld_resident_restarts = 0;
+
+static int ld_resident_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0)
+    {
+        const char* text = getenv("LD_RESIDENT_GEOMETRY");
+        enabled = (text && *text == '0') ? 0 : 1;
+    }
+    return enabled && g.geo && g.geo_mapped;
+}
+
+/* What a frame drew, by pipeline, for the [hitch] line: a frame with far
+ * more draws than usual (a big fight's effects, say) says which ones. */
+typedef struct
+{
+    u64 key;
+    u32 draws;
+    u64 vertices;
+    u32 target;
+} ld_tally_entry;
+
+#define LD_TALLY_SLOTS 256u
+static ld_tally_entry g_ld_frame_tally[LD_TALLY_SLOTS];
+static u32 g_ld_frame_tally_overflow = 0;
+static u32 g_ld_frame_soft_shadows = 0;
+static u32 g_ld_hitch_last_flip_words = 0;
+static u32 g_ld_hitch_last_passes = 0;
+static u32 g_ld_hitch_last_issued = 0;
+static u64 g_ld_hitch_last_requested = 0;
+static u32 g_ld_hitch_last_published = 0;
+static u32 g_ld_hitch_last_unpublished = 0;
+static u32 g_ld_hitch_last_fallback = 0;
+
+static void ld_frame_tally_note(u64 key, u32 vertices, u32 target)
+{
+    u32 slot = (u32)(key ^ (key >> 29) ^ (key >> 47)) & (LD_TALLY_SLOTS - 1u);
+    for (u32 probe = 0; probe < 16u; probe++)
+    {
+        ld_tally_entry* entry = &g_ld_frame_tally[(slot + probe) & (LD_TALLY_SLOTS - 1u)];
+        if (entry->draws == 0u || entry->key == key)
+        {
+            entry->key = key;
+            entry->draws++;
+            entry->vertices += vertices;
+            entry->target = target;
+            return;
+        }
+    }
+    g_ld_frame_tally_overflow++;
+}
+
+static void sink_end_impl(void* user, const rsx_dispatch* r)
+{
+    (void)user; (void)r;
+    if (g_ld_movie_mode && !ld_movie_composite_ui_enabled()) return;
+    if (!dc.n_packets) { g_ld_stats.groups_empty++; return; }
+    g_ld_stats.groups_seen++;
+    /*
+     * a010's native per-mesh constant builder can overwrite the otherwise
+     * valid reconstructed camera with NaNs after the ordinary camera upload.
+     * Repair at the last measured boundary, immediately before the draw
+     * consumes the constants. Once the synchronized a010 reference is armed,
+     * replace finite-but-wrong native uploads too: the measured failure
+     * matrix is finite, yet projects the model thousands of pixels offscreen.
+     */
+    if (InterlockedCompareExchange(&g_ld_a010_camera_ready, 0, 0) != 0) {
+        int camera_has_nan = 0;
+        for (u32 slot = 108; slot <= 111 && !camera_has_nan; slot++)
+            for (u32 lane = 0; lane < 4; lane++) {
+                const u32 bits = g.rsx.constants[slot][lane];
+                if ((bits & 0x7F800000u) == 0x7F800000u &&
+                    (bits & 0x007FFFFFu) != 0) {
+                    camera_has_nan = 1;
+                    break;
+                }
+            }
+        if (camera_has_nan || g_yz_runtime_config.a010_start_reference ||
+            InterlockedCompareExchange(
+                &g_yz_a010_reference_camera_active, 0, 0) != 0) {
+            for (u32 i = 0; i < 16; i++)
+                g.rsx.constants[108 + i / 4][i % 4] =
+                    g_ld_a010_camera_bits[i];
+            static u64 repairs = 0;
+            repairs++;
+            if (repairs <= 16 || (repairs & (repairs - 1)) == 0) {
+                fprintf(stderr,
+                        "[a010-rsx-camera-repair] n=%llu frame=%u "
+                        "c108=%08X/%08X/%08X/%08X\n",
+                        (unsigned long long)repairs, g_ld_frames,
+                        g.rsx.constants[108][0], g.rsx.constants[108][1],
+                        g.rsx.constants[108][2], g.rsx.constants[108][3]);
+                fflush(stderr);
+            }
+        }
+    }
+    /* A polygon is a convex fan around its first vertex -- what the register-
+     * file engine (rsx_draw_engine.c) and the null backend already make of one.
+     * Left unmapped it was dropped outright: Twisted Metal's legal screens
+     * submit 16-vertex polygons. */
+    const u32 prim = g.rsx.current_primitive == 10u /* POLYGON */
+        ? PRIM_TRIANGLE_FAN : g.rsx.current_primitive;
+    if (ld_repeat_draw(prim))
+    {
+        return;
+    }
+    g_ld_repeat.valid = 0;
+    g_ld_geom_hit_entry = NULL;
+    rsx_vertex_layout_plan used_layout;
+    ld_current_vertex_layout(&used_layout);
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.used_attribute_draws++;
+    g_ld_profile.total.used_attribute_sum += used_layout.count;
+    if (used_layout.count > g_ld_profile.frame_used_attribute_max)
+        g_ld_profile.frame_used_attribute_max = used_layout.count;
+    if (used_layout.count > g_ld_profile.total_used_attribute_max)
+        g_ld_profile.total_used_attribute_max = used_layout.count;
+    const LONGLONG fetch_pack_begin = ld_profile_qpc();
+#endif
+    const u64 fetchBegin = ld_perf_ticks();
+    if (ld_vertex_compact_payload()) {
+        fetch_batches_hoisted(&used_layout, 1);
+    } else if (ld_vertex_hoist_fetch()) {
+        rsx_vertex_layout_plan legacy_layout;
+        ld_layout_plan_get(0xFFFFu, &legacy_layout);
+        fetch_batches_hoisted(&legacy_layout, 0);
+    } else {
+        fetch_batches();
+    }
+    if (!dc.n_source_refs)
+        dc.n_source_refs = dc.n_verts;
+    g_ld_draw_perf.fetchTicks += ld_perf_ticks() - fetchBegin;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.vertex_fetch_pack_qpc +=
+        (u64)(ld_profile_qpc() - fetch_pack_begin);
+#endif
+    if (!dc.n_verts || !dc.fetch_ok) { g_ld_stats.group_drop_fetch++; return; }
+
+    /* Preserve validated occurrence order while allowing repeated compact
+     * vertex references to share one fetched and uploaded payload. */
+    int indexed = 0;
+    if (!rsx_vertex_topology_plan(prim, dc.refs_remapped, &indexed)) {
+        g_ld_stats.group_drop_primitive++;
+        return;
+    }
+    u32 n_tri = indexed
+        ? topology_index_count(prim)
+        : dc.n_source_refs - dc.n_source_refs % 3;
+
+    if (!n_tri) {
+        g_ld_stats.group_drop_degenerate++;
+        return;
+    }
+
+    live_a010_geom_trace(prim, n_tri);
+
+    const u32 vertex_stride =
+        ld_vertex_compact_payload() ? used_layout.stride : VERT_STRIDE;
+    const u32 uploaded_vertices = indexed ? dc.n_verts : n_tri;
+    const void* vertex_data = ld_vertex_compact_payload()
+        ? (const void*)dc.compact_verts : (const void*)dc.verts;
+    const u64 draw_vb_bytes = (u64)uploaded_vertices * vertex_stride;
+    const u64 draw_ib_bytes = indexed ? (u64)n_tri * sizeof(u32) : 0;
+    const u64 vb_capacity = VERT_BANK_SIZE;
+    /* Resident geometry: where this draw's vertices and indices are read
+     * from, and how much of the per-frame rings it takes (none when they are
+     * resident). */
+    rsx_geom_entry* residentEntry = g_ld_geom_hit_entry;
+    g_ld_geom_hit_entry = NULL;
+    const u64 residentVertexBytes = (draw_vb_bytes + 255u) & ~(u64)255u;
+    const u64 residentIndexBytes = (draw_ib_bytes + 255u) & ~(u64)255u;
+    int resident = 0;
+    if (residentEntry && draw_vb_bytes && ld_resident_enabled() &&
+        residentVertexBytes + residentIndexBytes <= LD_RESIDENT_BYTES / 8u)
+    {
+        if (residentEntry->resident_generation == g_ld_resident_generation &&
+            residentEntry->resident_vb_bytes == (u32)draw_vb_bytes &&
+            residentEntry->resident_ib_bytes == (u32)draw_ib_bytes &&
+            residentEntry->resident_primitive == prim && residentEntry->resident_indexed == indexed)
+        {
+            resident = 1;
+            g_ld_resident_reuses++;
+            g_ld_resident_reused_bytes += draw_vb_bytes + draw_ib_bytes;
+        }
+        else
+        {
+            if (g_ld_resident_used + residentVertexBytes + residentIndexBytes > LD_RESIDENT_BYTES)
+            {
+                /* Full: wait for the GPU to finish with all of it, then start
+                 * again (every entry's generation is now out of date). */
+                ld_flush(LD_FLUSH_VERTEX_RING);
+                ld_rings_reset();
+                g_ld_resident_generation++;
+                g_ld_resident_used = 0;
+                g_ld_resident_restarts++;
+            }
+            const u64 residentUploadBegin = ld_perf_ticks();
+            const u64 vertexOffset = g_ld_resident_used;
+            const u64 indexOffset = vertexOffset + residentVertexBytes;
+            memcpy(g.geo_mapped + vertexOffset, vertex_data, (size_t)draw_vb_bytes);
+            if (indexed)
+            {
+                write_topology_indices(prim, (u32*)(g.geo_mapped + indexOffset));
+            }
+            g_ld_resident_used = indexOffset + residentIndexBytes;
+            residentEntry->resident_generation = g_ld_resident_generation;
+            residentEntry->resident_vb_offset = (u32)vertexOffset;
+            residentEntry->resident_ib_offset = (u32)indexOffset;
+            residentEntry->resident_vb_bytes = (u32)draw_vb_bytes;
+            residentEntry->resident_ib_bytes = (u32)draw_ib_bytes;
+            residentEntry->resident_primitive = prim;
+            residentEntry->resident_indexed = indexed;
+            g_ld_draw_perf.uploadTicks += ld_perf_ticks() - residentUploadBegin;
+            g_ld_draw_perf.uploadBytes += draw_vb_bytes + draw_ib_bytes;
+            resident = 1;
+        }
+    }
+    const u64 ringVertexBytes = resident ? 0u : draw_vb_bytes;
+    const u64 ringIndexBytes = resident ? 0u : draw_ib_bytes;
+    const u64 geometryBase = resident ? g.geo->lpVtbl->GetGPUVirtualAddress(g.geo) : 0u;
+    const u64 vertexAddress = resident ? geometryBase + residentEntry->resident_vb_offset
+                                       : g.vb->lpVtbl->GetGPUVirtualAddress(g.vb) + g.vb_used;
+    if (!resident && (draw_vb_bytes > vb_capacity || draw_ib_bytes > INDEX_BANK_SIZE)) {
+        live_draw_csv_emit(prim, n_tri, "drop_vbring_oversize");
+        g_ld_stats.group_drop_ring++;
+        return;
+    }
+    if ((u64)g.vb_used + ringVertexBytes > ld_vb_end() ||
+        (u64)g.ib_used + ringIndexBytes > ld_ib_end()) {
+        /*
+         * The replay-proven renderer recycles this upload ring mid-frame.
+         * Live used to drop every remaining draw instead, which discarded
+         * 181/184 sampled a010 groups after the orphanage workload filled the
+         * 256K-vertex ring.  We are still before this draw's memcpy, so it is
+         * safe to submit/wait and reuse every transient draw ring here.
