+    memset(header, 0, sizeof(header));
+    ld_texture_dump_put32(header, 0, 0x20534444u);                 /* "DDS " */
+    ld_texture_dump_put32(header, 4, 124);
+    u32 flags = 0x1u | 0x2u | 0x4u | 0x1000u;                       /* CAPS HEIGHT WIDTH PIXELFORMAT */
+    if (mipCount > 1)
