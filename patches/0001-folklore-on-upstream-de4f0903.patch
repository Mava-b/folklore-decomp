+            const unsigned char* digit = cursor + 1;
+            while (*digit >= '0' && *digit <= '9')
+            {
+                sourceHash ^= *digit;
+                sourceHash *= 0x100000001B3ull;
+                digit++;
+            }
+            cursor = (*digit == ']') ? digit : digit - 1;
+            continue;
