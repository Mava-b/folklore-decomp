+void ps3_quit_gate_enter(void)
+{
+    __atomic_add_fetch(&s_quit_gate_inside, 1, __ATOMIC_SEQ_CST);
+    if (t_quit_gate_depth++ > 0 || !__atomic_load_n(&s_quit_gate_closed, __ATOMIC_SEQ_CST)) return;
+    t_quit_gate_depth--;
