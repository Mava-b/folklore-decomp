+
+/* One keyboard/mouse poll of port 0. */
+void test_pad_poll(unsigned* buttons, int* lx, int* ly, int* rx, int* ry)
+{
+    pad_poll_keys(0);
+    const PadHostState* hs = &s_host_state[0];
+    *buttons = hs->buttons;
+    *lx = hs->analog_lx; *ly = hs->analog_ly; *rx = hs->analog_rx; *ry = hs->analog_ry;
+}
