+    rsx_geom_cache_store(key, check, g_ld_frames, spans, n_spans,
+                         dc.refs, dc.n_refs, dc.n_source_refs, dc.refs_remapped,
+                         dc.ref_remap.occurrence_to_unique, dc.cuts, dc.n_cuts,
+                         dc.compact_verts, layout->stride);
