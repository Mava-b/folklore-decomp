+    sc.left = (LONG)ld_surface_x(drawSurface, (u32)sc.left);
+    sc.top = (LONG)ld_surface_scaled(drawSurface, (u32)sc.top);
+    sc.right = (LONG)ld_surface_x(drawSurface, (u32)sc.right);
+    sc.bottom = (LONG)ld_surface_scaled(drawSurface, (u32)sc.bottom);
+    if (hudPlace)
+    {
+        /* Ultrawide HUD: the draw goes into a 16:9-wide strip of the widened
+         * surface at its own proportions -- the middle one, or moved out
+         * towards the left or right edge by the edge setting; the scissor
+         * follows. */
+        const float hudWidth = dvp.Width / drawSurface->scale_x * renderScale;
+        const float centredLeft = (dvp.Width - hudWidth) * 0.5f;
+        const float edgeAmount = (float)InterlockedCompareExchange(&g_ld_hud_edge, 0, 0) / 100.0f;
+        float placedLeft = centredLeft;
+        if (hudPlace == LD_HUD_LEFT)
+        {
+            placedLeft = centredLeft * (1.0f - edgeAmount);
+        }
+        else if (hudPlace == LD_HUD_RIGHT)
+        {
+            placedLeft = centredLeft * (1.0f + edgeAmount);
+        }
+        const float hudLeft = (float)(LONG)placedLeft;
+        const float hudShrink = hudWidth / dvp.Width;
+        dvp.TopLeftX = hudLeft;
+        dvp.Width = hudWidth;
+        sc.left = (LONG)(hudLeft + (float)sc.left * hudShrink);
+        sc.right = (LONG)(hudLeft + (float)sc.right * hudShrink + 0.999f);
+    }
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &dvp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    /* Dynamic stencil reference (kept out of the PSO key on purpose). */
+    g.list->lpVtbl->OMSetStencilRef(
+        g.list, rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu);
+    ld_set_blend_factor();
+
+    D3D12_VERTEX_BUFFER_VIEW vbv;
+    vbv.BufferLocation = resident ? vertexAddress : g.vb->lpVtbl->GetGPUVirtualAddress(g.vb) + g.vb_used;
+    vbv.StrideInBytes = vertex_stride;
+    vbv.SizeInBytes = (u32)draw_vb_bytes;
+    if (vertex_stride)
+        g.list->lpVtbl->IASetVertexBuffers(g.list, 0, 1, &vbv);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    {
+        const u64 serial = ++g_ld_recent_draw_total;
+        ld_recent_draw* draw =
+            &g_ld_recent_draws[(serial - 1u) & (LD_RECENT_DRAW_CAP - 1u)];
+        memset(draw, 0, sizeof(*draw));
+        draw->serial = serial;
+        draw->frame = g_ld_frames;
+        draw->pso_key = g_ld_current_pso.key;
+        draw->descriptor_signature = descriptor_signature;
+        draw->vp_start = g_ld_current_pso.vp_start;
+        draw->vp_instrs = g_ld_current_pso.vp_instrs;
+        draw->fp_location = g_ld_current_pso.fp_location;
+        draw->fp_offset = g_ld_current_pso.fp_offset;
+        draw->fp_size = g_ld_current_pso.fp_size;
+        draw->fp_control = g_ld_current_pso.fp_control;
+        draw->cube_mask = g_ld_current_pso.cube_mask;
+        draw->vtex_mask = g_ld_current_pso.vtex_mask;
+        draw->txl_mask = g_ld_current_pso.txl_mask;
+        draw->texture_mask = texture_mask;
+        draw->primitive = prim;
+        draw->vertices = n_tri;
+        draw->target = target;
+        draw->zslot = current_zslot;
+        draw->clip_x = sf.clip_x;
+        draw->clip_y = sf.clip_y;
+        draw->clip_w = sf.clip_w;
+        draw->clip_h = sf.clip_h;
+        draw->srv_ring_used = g.srv_ring_used;
+        draw->sampler_ring_used = g.smp_ring_used;
+        draw->cb_used = g.cb_used;
+        draw->vb_used = g.vb_used;
+    }
+    int softShadowDrawn = 0;
+    if (have_dsv && current_zslot &&
+        ld_soft_shadow_draw(drawSurface, rtv, dsv, &dvp, &sc, Wv, Hv, xf)) {
+        /* Drawn by the soft shadow passes instead. */
+        softShadowDrawn = 1;
+        g_ld_frame_soft_shadows++;
+    } else if (indexed) {
+        D3D12_INDEX_BUFFER_VIEW ibv;
+        ibv.BufferLocation = indexAddress;
+        ibv.SizeInBytes = (u32)draw_ib_bytes;
+        ibv.Format = DXGI_FORMAT_R32_UINT;
+        g.list->lpVtbl->IASetIndexBuffer(g.list, &ibv);
+        g.list->lpVtbl->DrawIndexedInstanced(
+            g.list, n_tri, 1, 0, 0, 0);
+    } else {
+        g.list->lpVtbl->DrawInstanced(g.list, n_tri, 1, 0, 0);
+    }
+    /* Keep what the repeat-draw path needs to draw this again with new
+     * constants (see ld_repeat_draw). */
+    {
+        int scanoutTarget = 0;
+        for (u32 bufferIndex = 0; bufferIndex < 8; bufferIndex++)
+        {
+            const display_buffer_t* display = &g.display_buffers[bufferIndex];
+            if (display->valid && display->location == drawSurface->location &&
+                display->offset == drawSurface->offset)
+            {
+                scanoutTarget = 1;
+                break;
+            }
+        }
+        /* Only ordinary textures: a render target, a depth buffer or a copy
+         * of its own target read as a texture can change between two draws. */
+        int plainTextures = 1;
+        for (u32 slotIndex = 0; slotIndex < SRV_TABLE_SIZE; slotIndex++)
+        {
+            if (slots[slotIndex] != SRV_WHITE &&
+                !(slots[slotIndex] >= SRV_TEXTURE_BASE && slots[slotIndex] < SRV_VTEX_BASE))
+            {
+                plainTextures = 0;
+                break;
+            }
+        }
+        ld_repeat_state* repeat = &g_ld_repeat;
+        repeat->valid = 0;
+        if (InterlockedCompareExchange(&g_ld_repeat_draws, 0, 0) && !s_csv_file && !softShadowDrawn && !hudPlace &&
+            !scanoutTarget && plainTextures && n_surf_used == 0 && !dc.inl && dc.n_arr <= LD_REPEAT_MAX_BATCHES &&
+            dc.n_idx <= LD_REPEAT_MAX_BATCHES && n_mrt >= 1u && n_mrt <= 4u && !g_ld_probe_variant)
+        {
+            repeat->fragmentHash = ld_repeat_fragment_hash(g_ld_current_pso.fp_location, g_ld_current_pso.fp_offset,
+                                                           g_ld_current_pso.fp_size);
+            if (repeat->fragmentHash)
+            {
+                repeat->epoch = g_ld_ring_epoch;
+                repeat->frame = g_ld_frames;
+                repeat->stateGeneration = g.rsx.state_generation;
+                repeat->vpGeneration = g.rsx.vp_generation;
+                repeat->primitive = prim;
+                repeat->arrayCount = dc.n_arr;
+                repeat->indexBatchCount = dc.n_idx;
+                memcpy(repeat->arrays, dc.arr, (size_t)dc.n_arr * sizeof(batch_t));
+                memcpy(repeat->indexBatches, dc.idx, (size_t)dc.n_idx * sizeof(batch_t));
+                repeat->pipeline = pso;
+                repeat->metadata = g_ld_current_pso;
+                repeat->textureTable = table;
+                repeat->samplerTable = stbl;
+                repeat->vertexTextureTable = vtex_table;
+                repeat->vertexTextureMask = vtex_mask;
+                repeat->renderTargetCount = n_mrt;
+                repeat->renderTargets[0] = rtv;
+                repeat->targets[0] = target;
+                for (u32 targetIndex = 1; targetIndex < n_mrt; targetIndex++)
+                {
+                    repeat->renderTargets[targetIndex] = rtv_handle(LD_SWAP_BUFFERS + mrt[targetIndex]);
+                    repeat->targets[targetIndex] = mrt[targetIndex];
+                }
+                repeat->haveDepthStencil = have_dsv;
+                if (have_dsv)
+                {
+                    repeat->depthStencil = dsv;
+                }
+                repeat->depthSlot = current_zslot;
+                repeat->depthTest = (rsx_dsp_reg(&g.rsx, M_DEPTH_TEST_ENABLE) & 1u) != 0;
+                repeat->depthWrite = (rsx_dsp_reg(&g.rsx, M_DEPTH_WRITE) & 1u) != 0;
+                repeat->viewport = dvp;
+                repeat->scissor = sc;
+                repeat->vertexBuffer = vbv;
+                repeat->haveVertexBuffer = vertex_stride != 0;
+                repeat->indexed = indexed;
+                if (indexed)
+                {
+                    repeat->indexBuffer.BufferLocation = indexAddress;
+                    repeat->indexBuffer.SizeInBytes = (u32)draw_ib_bytes;
+                    repeat->indexBuffer.Format = DXGI_FORMAT_R32_UINT;
+                }
+                repeat->vertexCount = n_tri;
+                memcpy(repeat->viewportTransform, xf, sizeof(repeat->viewportTransform));
+                repeat->valid = 1;
+            }
+        }
+    }
+    ld_surface_note_write(target, LD_SURFACE_WRITE_DRAW);
+    for (u32 r = 1; r < n_mrt; r++)
+        ld_surface_note_write(mrt[r], LD_SURFACE_WRITE_DRAW);
+    if (current_zslot) {
+        render_state_t depth_state;
+        decode_render_state(&depth_state);
+        zdepth_t* z = &g.zdepths[current_zslot - 1];
+        z->draws++;
+        if (depth_state.depth_test) z->depth_test_draws++;
+        if (depth_state.depth_write) z->depth_write_draws++;
+        if (depth_state.depth_test && depth_state.depth_write)
+            z->depth_both_draws++;
+        /* A write-enable bit alone does not prove that this draw produced a
+         * usable depth map.  With depth testing disabled RSX does not execute
+         * the depth pass represented by this tracked zeta. */
+        if (depth_state.depth_test && depth_state.depth_write)
+            z->had_write = 1;
+    }
+    g_ld_stats.groups_executed++;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.input_vertices += dc.n_source_refs;
+    g_ld_profile.total.expanded_vertices += n_tri;
+    g_ld_profile.total.legacy_vertex_upload_bytes +=
+        (u64)(prim == PRIM_TRIANGLES ? n_tri : dc.n_source_refs) *
+        VERT_STRIDE;
+    g_ld_profile.total.vertex_upload_bytes += draw_vb_bytes;
+#endif
+
+    for (u32 k = 0; k < n_surf_used; k++) {
+        bar.Transition.pResource = g.surfaces[surf_used[k]].tex;
+        bar.Transition.StateBefore = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+        bar.Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        g.list->lpVtbl->ResourceBarrier(g.list, 1, &bar);
+    }
+    /* A guest-side failure can occur before the next flip even though useful
+     * orphanage draws have already reached internal world targets.  Preserve
+     * a few progressively later surface snapshots directly from the draw
+     * stream so presentation is not a prerequisite for visual diagnosis. */
+    if (LD_DIAG_ENABLED("RSX_A010_EAGER_DUMP") &&
+        InterlockedCompareExchange(&g_ld_a010_world_ready, 0, 0) != 0) {
+        static u64 eager_origin = 0;
+        static u32 eager_sample = 0;
+        if (!eager_origin)
+            eager_origin = g_ld_stats.groups_executed;
+        if (eager_sample < 4u &&
+            g_ld_stats.groups_executed >=
+                eager_origin + (u64)eager_sample * 32u) {
+            CreateDirectoryA("scratch\\a010_probe", NULL);
+            for (u32 i = 0; i < g.n_surfaces; i++) {
+                const u32 off = g.surfaces[i].offset;
+                if (off != 0x00E40000u && off != 0x01800000u &&
+                    off != 0x02D10000u && off != 0x02710000u &&
+                    off != 0x01440000u)
+                    continue;
+                char path[256];
+                snprintf(path, sizeof(path),
+                         "scratch\\a010_probe\\eager_%03u_group_%08llu_"
+                         "surface_%02u_off_%08X.ppm",
+                         eager_sample,
+                         (unsigned long long)g_ld_stats.groups_executed,
+                         i, off);
+                ld_dump_surface_ppm(path, &g.surfaces[i]);
+            }
+            fprintf(stderr,
+                    "[a010-eager-dump] sample=%u groups=%llu surfaces=%u\n",
+                    eager_sample,
+                    (unsigned long long)g_ld_stats.groups_executed,
+                    g.n_surfaces);
+            eager_sample++;
+            fflush(stderr);
+        }
+    }
+    g.vb_used += (u32)ringVertexBytes;
+    g.ib_used += (u32)ringIndexBytes;
+    ld_profile_note_ring_highwater();
+    g_ld_draw_perf.submitTicks += ld_perf_ticks() - submitBegin;
+}
+
+static void sink_end(void* user, const rsx_dispatch* r)
+{
+#if defined(YZ_PERF_PROFILE)
+    const LONGLONG begin = ld_profile_qpc();
+#endif
+    const u64 drawBegin = ld_perf_ticks();
+    sink_end_impl(user, r);
+    g_ld_draw_perf.totalTicks += ld_perf_ticks() - drawBegin;
+    g_ld_draw_perf.draws++;
+#if defined(YZ_PERF_PROFILE)
+    g_ld_profile.total.sink_end_qpc += (u64)(ld_profile_qpc() - begin);
+#endif
+}
