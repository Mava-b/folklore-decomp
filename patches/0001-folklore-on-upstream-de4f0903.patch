+            break;
+        }
+    }
+    ReleaseSRWLockShared(&g_ld_ps_replacement_lock);
+    if (replaced)
+    {
+        static int replacementLogs = 0;
+        if (replacementLogs < 16)
+        {
+            replacementLogs++;
