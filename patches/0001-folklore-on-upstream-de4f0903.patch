+    if (s_mouse_on && pad_input_mode() != PAD_MODE_CONTROLLER) {
+        f |= PS3_HOST_INPUT_MOUSE_CAMERA;
+        if (s_mouse_capture) f |= PS3_HOST_INPUT_CAPTURE;
+    }
+    return f;
+}
