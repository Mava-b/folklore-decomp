+static const char* pad_hid_kind_name(PadHidKind kind)
+{
+    switch (kind)
+    {
+    case PAD_HID_DUALSHOCK4:
+        return "DualShock 4";
+    case PAD_HID_DUALSENSE:
+        return "DualSense";
+    case PAD_HID_SWITCH_PRO:
+        return "Switch Pro Controller";
+    default:
+        return NULL;
+    }
+}
