@@ -52,6 +52,9 @@ int  rsx_process_vp_run(rsx_state* state, u32 method, const u8* src, u32 count)
 int  rsx_draw_engine_enabled(void) { return 1; }
 rsx_backend* rsx_get_backend(void) { return NULL; }
