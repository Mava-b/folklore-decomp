+static const char* fs_aio_file_name(const std::string& hostPath)
+{
+    const size_t slash = hostPath.find_last_of("/\\");
+    return slash == std::string::npos ? hostPath.c_str() : hostPath.c_str() + slash + 1;
+}
+
+static std::mutex                s_aioMutex;
+static std::condition_variable   s_aioWake;
+static std::deque<FsAioRequest>  s_aioQueue;
+static bool                      s_aioStarted = false;
+
+static size_t fs_aio_perform(const FsAioRequest& request, int32_t* error)
+{
+    size_t bytesRead = 0;
+    *error = CELL_FS_ENOENT;
+    FILE* file = request.hostPath.empty() ? nullptr : fopen(request.hostPath.c_str(), "rb");
+    if (!file)
+    {
+        return 0;
+    }
+    uint64_t size = request.size;
+    if (ppu_vm_size && (uint64_t)request.buffer + size > ppu_vm_size)
+    {
+        size = ppu_vm_size - request.buffer;
+    }
+    fs_prefault(request.buffer, size);
+    if (HOST_FSEEK64(file, request.offset) == 0)
+    {
+        bytesRead = fread(vm_base + request.buffer, 1, (size_t)size, file);
+    }
+    fclose(file);
+    *error = CELL_OK;
+    return bytesRead;
+}
+
+static void fs_aio_worker()
+{
+    for (;;)
+    {
+        FsAioRequest request;
+        {
+            std::unique_lock<std::mutex> lock(s_aioMutex);
+            s_aioWake.wait(lock, [] { return !s_aioQueue.empty(); });
+            request = std::move(s_aioQueue.front());
+            s_aioQueue.pop_front();
+        }
+        /* Disc latency. Completing in microseconds exposes a race in
+         * Folklore's movie player: MovieOpen clears its "hold" flag and
+         * signals the presentation thread when the first read lands, and that
+         * thread only notices the hold on a 10 ms poll -- if the signal comes
+         * first it is lost and the movie never shows a frame. A Blu-ray read
+         * takes tens of milliseconds, which is the ordering the title was
+         * written against. PS3_FS_AIO_LATENCY_MS overrides (0 = none). */
+        {
+            static int s_latencyMs = -1;
+            if (s_latencyMs < 0)
+            {
+                const char* text = getenv("PS3_FS_AIO_LATENCY_MS");
+                s_latencyMs = text ? atoi(text) : 25;
+            }
+            if (s_latencyMs > 0)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(s_latencyMs));
+            }
+        }
+        int32_t error = CELL_OK;
+        size_t bytesRead = fs_aio_perform(request, &error);
+        if (fs_aio_log_enabled())
+        {
+            fprintf(stderr, "[fs-aio] done   id=%d %s buf=0x%08X..0x%08llX bytes=0x%zX\n",
+                    request.id, fs_aio_file_name(request.hostPath), request.buffer,
+                    (unsigned long long)request.buffer + bytesRead, bytesRead);
+        }
+        if (getenv("PS3_FSLOG"))
+        {
+            fprintf(stderr, "[fs] aio read id=%d fd=%d off=%llu size=%llu -> %zu (async)\n",
+                    request.id, request.fd, (unsigned long long)request.offset,
+                    (unsigned long long)request.size, bytesRead);
+        }
+        if (request.callbackOpd)
+        {
+            ps3_invoke_guest(request.callbackOpd, request.aio, (uint64_t)(int64_t)error,
+                             (uint64_t)(int64_t)request.id, (uint64_t)bytesRead, 0, 0, 0, 0);
+        }
+    }
+}
