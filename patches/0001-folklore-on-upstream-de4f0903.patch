+/* PS3_FS_AIO_LOG=1: one line per AIO submit and completion, with the guest
+ * buffer it lands in -- for finding which read overwrote a structure. */
+static bool fs_aio_log_enabled()
+{
+    static int s_enabled = -1;
+    if (s_enabled < 0)
+    {
+        s_enabled = getenv("PS3_FS_AIO_LOG") ? 1 : 0;
+    }
+    return s_enabled == 1;
+}
