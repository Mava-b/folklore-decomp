+/* Guest stacks of threads that have gone. The stack region is a bump
+ * allocator that never takes anything back, so without this every thread a
+ * title ever creates costs its stack for good: Folklore starts a 256 KB
+ * stream thread for every music and ambience change. Called under the table
+ * lock. */
+typedef struct ppu_free_stack {
+    uint32_t base;
+    uint32_t size;
+} ppu_free_stack;
+static ppu_free_stack s_freeStacks[PPU_THREAD_MAX];
+static int s_freeStackCount;
+static uint32_t s_slotStackBlock[PPU_THREAD_MAX];   /* block size behind each slot's stack */
+
+static void ppu_stack_release(uint32_t stackBase, uint32_t blockSize)
+{
+    if (stackBase == 0 || blockSize == 0)
+    {
+        return;
+    }
+    if (s_freeStackCount < PPU_THREAD_MAX)
+    {
+        s_freeStacks[s_freeStackCount].base = stackBase;
+        s_freeStacks[s_freeStackCount].size = blockSize;
+        s_freeStackCount++;
+    }
+}
+
+/* The smallest free stack that fits, or a new one. Returns the base and the
+ * size of the block behind it. */
+static uint32_t ppu_stack_take(uint32_t stackSize, uint32_t* blockSizeOut)
+{
+    int bestIndex = -1;
+    for (int freeIndex = 0; freeIndex < s_freeStackCount; freeIndex++)
+    {
+        if (s_freeStacks[freeIndex].size < stackSize)
+        {
+            continue;
+        }
+        if (bestIndex < 0 || s_freeStacks[freeIndex].size < s_freeStacks[bestIndex].size)
+        {
+            bestIndex = freeIndex;
+        }
+    }
+    if (bestIndex >= 0)
+    {
+        uint32_t stackBase = s_freeStacks[bestIndex].base;
+        *blockSizeOut = s_freeStacks[bestIndex].size;
+        s_freeStackCount--;
+        s_freeStacks[bestIndex] = s_freeStacks[s_freeStackCount];
+        /* A new thread's stack starts out zeroed, as a fresh one would. */
+        memset(vm_to_host(stackBase), 0, *blockSizeOut);
+        return stackBase;
+    }
+    uint32_t pageSize = vm_host_page_size();
+    *blockSizeOut = VM_ALIGN_UP(stackSize, pageSize);
+    return vm_stack_allocate(&g_vm_stack_alloc, stackSize);
+}
+
+/* Give a thread's slot back: host handles, join objects and guest stack.
+ * Called under the table lock, once nothing will touch the slot again. */
+static void ppu_thread_release_slot(ppu_thread_info* threadInfo)
+{
+    int slotIndex = (int)(threadInfo - g_ppu_threads);
+#ifdef _WIN32
+    if (threadInfo->host_thread)
+    {
+        CloseHandle(threadInfo->host_thread);
+        threadInfo->host_thread = NULL;
+    }
+    if (threadInfo->finish_event)
+    {
+        CloseHandle(threadInfo->finish_event);
+        threadInfo->finish_event = NULL;
+    }
+#else
+    pthread_mutex_destroy(&threadInfo->finish_mutex);
+    pthread_cond_destroy(&threadInfo->finish_cond);
+#endif
+    if (slotIndex > 0 && slotIndex < PPU_THREAD_MAX)
+    {
+        ppu_stack_release(threadInfo->stack_addr, s_slotStackBlock[slotIndex]);
+        s_slotStackBlock[slotIndex] = 0;
+        /* Its TLS block too (ppu_loader.cpp gives each thread its own). */
+        extern void ppu_tls_release_block(uint32_t threadPointer);
+        ppu_tls_release_block((uint32_t)threadInfo->ctx.gpr[13]);
+        threadInfo->ctx.gpr[13] = 0;
+    }
+    threadInfo->stack_addr = 0;
+    threadInfo->state = PPU_THREAD_STATE_FREE;
+}
